#!/bin/bash
# winmac — roda seus jogos Windows no Mac com o Wine Staging (grátis, open source).
# Uso:
#   winmac setup [bottle]     instala o Wine (se faltar) e a Steam oficial num bottle novo
#   winmac list               lista bottles e jogos da Steam
#   winmac steam [bottle]     abre a Steam
#   winmac play <appid|nome>  abre um jogo (com o D3DMetal da Apple, se o Game Porting Toolkit estiver instalado)
#   winmac d3dmetal <appid> on|off   liga/desliga o D3DMetal num jogo
#   winmac run <exe> [bottle] roda qualquer .exe
#   winmac detect             lista bottles do CrossOver que têm Steam (nome<TAB>nº de jogos)
#   winmac import             traz para o WinMac todos os bottles do CrossOver que têm Steam (jogos, saves, login)
#   winmac migrate [bottle]   move o bottle do CrossOver para ~/winmac/Bottles (deixa atalho de volta)
#   winmac kill [bottle]      fecha tudo que está rodando no bottle
#   winmac restore [bottle]   restaura o registro original do CrossOver (backup)

WINE="/Applications/Wine Staging.app/Contents/Resources/wine/bin/wine"
WINESERVER="/Applications/Wine Staging.app/Contents/Resources/wine/bin/wineserver"
HOME_DIR="$HOME/winmac"
CX_BOTTLES="$HOME/Library/Application Support/CrossOver/Bottles"
DEFAULT_BOTTLE="Steam"
STEAM_EXE='C:\Program Files (x86)\Steam\steam.exe'
# -noverifyfiles: impede a Steam de desfazer o embrulho do steamwebhelper (ver fix_webhelper)
STEAM_ARGS=(-noverifyfiles)
WRAP_EXE="$HOME_DIR/tools/steamwebhelper-wrap.exe"
WEBHELPER_FLAGS="--disable-gpu --disable-gpu-compositing --in-process-gpu --disable-features=CalculateNativeWinOcclusion --disable-direct-composition"

bottle_path() {
  local name="${1:-$DEFAULT_BOTTLE}"
  if [ -d "$HOME_DIR/Bottles/$name" ]; then echo "$HOME_DIR/Bottles/$name"
  else echo "$CX_BOTTLES/$name"; fi
}

# DLLs que o CrossOver coloca no bottle e que derrubam o Wine comum (ex.: steamwebhelper.exe trava).
# Ficam guardadas em ~/winmac/crossover-dlls/<bottle> para poder devolver.
CX_DLLS=(system32/atidxx64.dll system32/nvapi64.dll system32/nvngx.dll system32/nvngx-on-metalfx.dll
         system32/winemetal.dll system32/wpcap.dll syswow64/winemetal.dll syswow64/wpcap.dll)
set_aside_crossover_dlls() {
  local win="$1/drive_c/windows" dest="$HOME_DIR/crossover-dlls/$(basename "$1")" f
  for f in "${CX_DLLS[@]}"; do
    [ -f "$win/$f" ] || continue
    mkdir -p "$dest/$(dirname "$f")" && mv "$win/$f" "$dest/$f"
  done
}

setup_env() {
  export WINEPREFIX="$(bottle_path "$1")"
  export WINEESYNC=1
  export WINEDEBUG=-all
  export MTL_HUD_ENABLED="${MTL_HUD_ENABLED:-0}"
  # Bottles do CrossOver usam o usuário Windows "crossover"; mantém o mesmo para os saves continuarem no lugar
  [ -d "$WINEPREFIX/drive_c/users/crossover" ] && export USER=crossover
  [ -x "$WINE" ] || { echo "Wine Staging não encontrado em /Applications/Wine Staging.app"; exit 1; }
  [ -d "$WINEPREFIX" ] || { echo "Bottle não encontrado: $WINEPREFIX"; exit 1; }
  set_aside_crossover_dlls "$WINEPREFIX"
  if pgrep -f "CrossOver.app/.*wineserver" >/dev/null; then
    echo "O CrossOver está rodando. Feche a Steam/CrossOver antes de usar o winmac no mesmo bottle."; exit 1
  fi
  configure_bottle
}

WINE_URL="https://github.com/Gcenx/macOS_Wine_builds/releases/download/11.18/wine-staging-11.18-osx64.tar.xz"
DXVK_URL="https://github.com/Gcenx/DXVK-macOS/releases/download/v1.10.3-20230507-repack/dxvk-macOS-async-v1.10.3-20230507-repack.tar.gz"
STEAM_SETUP_URL="https://cdn.cloudflare.steamstatic.com/client/installer/SteamSetup.exe"

install_wine() {
  [ -x "$WINE" ] && return 0
  echo "Baixando o Wine Staging..."
  local tmp; tmp=$(mktemp -d)
  curl -fL# -o "$tmp/wine.tar.xz" "$WINE_URL" && tar -xJf "$tmp/wine.tar.xz" -C "$tmp" \
    && mv "$tmp/Wine Staging.app" /Applications/ && xattr -dr com.apple.quarantine "/Applications/Wine Staging.app"
  rm -rf "$tmp"
  [ -x "$WINE" ] || { echo "Falha ao instalar o Wine."; exit 1; }
}

# DXVK (DirectX 10/11 -> Vulkan/Metal): sem ele os jogos DX11 falham com "Failed to initialize graphics"
install_dxvk() {
  local cache="$HOME_DIR/dxvk" src d
  src=$(ls -d "$cache"/dxvk-macOS-* 2>/dev/null | head -1)
  if [ -z "$src" ]; then
    echo "Baixando o DXVK..."
    mkdir -p "$cache" && curl -fsL "$DXVK_URL" | tar -xz -C "$cache" || { echo "Falha ao baixar o DXVK."; return 1; }
    src=$(ls -d "$cache"/dxvk-macOS-* | head -1)
  fi
  for d in d3d11 d3d10core; do
    cp "$src/x64/$d.dll" "$WINEPREFIX/drive_c/windows/system32/"
    cp "$src/x32/$d.dll" "$WINEPREFIX/drive_c/windows/syswow64/"
    "$WINE" reg add 'HKCU\Software\Wine\DllOverrides' /v $d /t REG_SZ /d native,builtin /f >/dev/null 2>&1
  done
}

# Ajustes feitos uma vez por bottle
configure_bottle() {
  [ -f "$WINEPREFIX/.winmac-ok" ] && return 0
  [ -d "$WINEPREFIX/drive_c/windows/system32" ] || return 0   # bottle ainda vazio (winmac setup)
  install_dxvk || return 1
  "$WINE" reg add 'HKCU\Software\Wine\WineDbg' /v ShowCrashDialog /t REG_DWORD /d 0 /f >/dev/null 2>&1
  touch "$WINEPREFIX/.winmac-ok"
}

steam_installed() { [ -f "$(bottle_path "$1")/drive_c/Program Files (x86)/Steam/steam.exe" ]; }

# A janela da Steam fica preta no Wine do macOS porque o navegador interno (steamwebhelper)
# desenha pela GPU. O embrulho chama o steamwebhelper original com opções do Chromium para
# desenhar por software. Se a Steam se atualizar e trocar o arquivo, ele é reaplicado aqui.
fix_webhelper() {
  local dir="$WINEPREFIX/drive_c/Program Files (x86)/Steam/bin/cef/cef.win64"
  [ -f "$dir/steamwebhelper.exe" ] && [ -f "$WRAP_EXE" ] || return 0
  if ! cmp -s "$WRAP_EXE" "$dir/steamwebhelper.exe"; then
    # O original da Steam tem vários MB; o embrulho tem ~150 KB. Só guarda como _real se for o original
    # (senão, ao atualizar o embrulho, a versão antiga dele apagaria o original).
    if [ "$(stat -f%z "$dir/steamwebhelper.exe")" -gt 1000000 ]; then
      mv -f "$dir/steamwebhelper.exe" "$dir/steamwebhelper_real.exe"
    fi
    cp "$WRAP_EXE" "$dir/steamwebhelper.exe"
  fi
  [ -f "$dir/steamwebhelper_real.exe" ] || return 0
  echo "$WEBHELPER_FLAGS" > "$dir/winmac_flags.txt"
}

# Jogos "overlay" (fundo transparente por cima da área de trabalho) usam DwmExtendFrameIntoClientArea,
# que o Wine do macOS não implementa: o fundo fica preto. O winmac-transparent.dylib é carregado nos
# processos do Wine e deixa a janela desses jogos transparente. A lista é montada procurando, nos jogos
# Unity instalados, o uso de DwmExtendFrameIntoClientArea.
TRANSPARENT_DYLIB="$HOME_DIR/tools/winmac-transparent.dylib"
transparent_exes() {
  local common="$(steam_apps "$1")/common" dll dir exes=""
  for dll in "$common"/*/*_Data/Managed/Assembly-CSharp.dll; do
    [ -f "$dll" ] && grep -q -a "DwmExtendFrameIntoClientArea" "$dll" || continue
    dir=$(dirname "$(dirname "$dll")")              # .../Jogo_Data
    exes="$exes:$(basename "${dir%_Data}").exe"
  done
  echo "${exes#:}"
}

# Abre a Steam (com argumentos extras) já com o módulo de transparência
launch_steam() {
  # Sobras de uma sessão do Wine que travou (processos sem wineserver) impedem a Steam de abrir
  if ! pgrep -x wineserver >/dev/null && pgrep -f '^C:\\' >/dev/null; then
    pkill -9 -f '^C:\\'
    sleep 1
  fi
  export WINMAC_TRANSPARENT_EXES="$(transparent_exes "$BOTTLE")"
  if [ -n "$WINMAC_TRANSPARENT_EXES" ] && [ -f "$TRANSPARENT_DYLIB" ]; then
    export DYLD_INSERT_LIBRARIES="$TRANSPARENT_DYLIB"
  fi
  # Sem nohup: ele é um programa protegido do macOS e apagaria o DYLD_INSERT_LIBRARIES
  "$WINE" "$STEAM_EXE" "${STEAM_ARGS[@]}" "$@" >/dev/null 2>&1 &
  disown
}

# ---------- D3DMetal (Game Porting Toolkit da Apple) ----------
# O D3DMetal traduz DirectX 11/12 direto para Metal e é bem mais rápido que o DXVK (ex.: Internet Cafe
# Simulator: 22 → 89 FPS no M2). Ele só funciona no Wine do Game Porting Toolkit, que não roda a Steam;
# por isso a Steam continua no Wine Staging e o jogo abre direto no Wine do GPTK, num bottle-sombra
# (~/winmac/Bottles/.d3dmetal-<bottle>) que usa a mesma pasta de usuário (saves em arquivo) e copia as
# configurações/saves do Unity (registro) na ida e na volta. Se o jogo fechar logo (ex.: exige a Steam),
# o WinMac abre pela Steam e lembra disso para a próxima vez.
GPTK_DIR="/Applications/Game Porting Toolkit.app/Contents/Resources/wine"
GPTK_WINE="$GPTK_DIR/bin/wine64"
GPTK_WINESERVER="$GPTK_DIR/bin/wineserver"
D3DM_OFF="$HOME_DIR/d3dmetal-off"   # appids que não abrem com o D3DMetal

has_d3dmetal() { [ -x "$GPTK_WINE" ] && [ -d "$GPTK_DIR/lib/external/D3DMetal.framework" ]; }
d3dmetal_off() { grep -qx "$1" "$D3DM_OFF" 2>/dev/null; }
set_d3dmetal() {
  touch "$D3DM_OFF"; grep -vx "$1" "$D3DM_OFF" > "$D3DM_OFF.tmp"; mv "$D3DM_OFF.tmp" "$D3DM_OFF"
  [ "$2" = off ] && echo "$1" >> "$D3DM_OFF"
}

# .exe principal do jogo: o do Unity (tem a pasta <nome>_Data) ou o maior .exe que não é instalador/ajudante
game_exe() {
  local dir="$1" e best
  while IFS= read -r e; do
    [ -d "${e%.exe}_Data" ] && { echo "$e"; return; }
  done < <(find "$dir" -maxdepth 3 -iname '*.exe' 2>/dev/null)
  best=$(find "$dir" -maxdepth 3 -iname '*.exe' 2>/dev/null \
    | grep -viE 'unitycrashhandler|trial|demo|unins|setup|redist|vcredist|dxsetup|crashreport|easyanticheat|battleye|_be\.exe' \
    | while IFS= read -r e; do echo "$(stat -f %z "$e") $e"; done | sort -rn | head -1 | cut -d' ' -f2-)
  echo "$best"
}

# Chave do registro onde o Unity guarda configurações e saves (PlayerPrefs)
unity_prefs_key() {
  local info="${1%.exe}_Data/app.info" company product
  [ -f "$info" ] || return 1
  company=$(sed -n 1p "$info" | tr -d '\r'); product=$(sed -n 2p "$info" | tr -d '\r')
  [ -n "$company" ] && [ -n "$product" ] && echo "HKCU\\Software\\$company\\$product"
}

# Copia uma chave do registro de um bottle para outro (apaga a antiga no destino antes)
copy_reg_key() {  # <wine origem> <prefixo origem> <wine destino> <prefixo destino> <chave>
  local tmp="winmac-sync-$$.reg"
  WINEPREFIX="$2" "$1" reg export "$5" "C:\\$tmp" /y >/dev/null 2>&1 || return 1
  mv "$2/drive_c/$tmp" "$4/drive_c/$tmp" || return 1
  WINEPREFIX="$4" "$3" reg delete "$5" /f >/dev/null 2>&1
  WINEPREFIX="$4" "$3" reg import "C:\\$tmp" >/dev/null 2>&1
  rm -f "$4/drive_c/$tmp"
}

# Bottle-sombra do GPTK, que divide a pasta de usuário (AppData, Documentos) com o bottle da Steam
d3dmetal_prefix() {
  local shadow="$HOME_DIR/Bottles/.d3dmetal-$(basename "$WINEPREFIX")" u="$USER"
  if [ ! -d "$shadow/drive_c/windows" ]; then
    echo "Preparando o D3DMetal (só na primeira vez)..." >&2
    WINEPREFIX="$shadow" "$GPTK_WINE" wineboot -i >/dev/null 2>&1
    WINEPREFIX="$shadow" "$GPTK_WINESERVER" -w
  fi
  if [ -d "$WINEPREFIX/drive_c/users/$u" ] && [ ! -L "$shadow/drive_c/users/$u" ]; then
    rm -rf "$shadow/drive_c/users/$u" && ln -s "$WINEPREFIX/drive_c/users/$u" "$shadow/drive_c/users/$u"
  fi
  echo "$shadow"
}

# Abre o jogo com o D3DMetal; volta para a Steam se não der. Retorna 1 se nem tentou.
play_d3dmetal() {
  local id="$1" acf dir exe key shadow
  has_d3dmetal && ! d3dmetal_off "$id" || return 1
  acf="$(steam_apps "$BOTTLE")/appmanifest_$id.acf"
  [ -f "$acf" ] || return 1
  dir="$(steam_apps "$BOTTLE")/common/$(sed -n 's/.*"installdir"[[:space:]]*"\(.*\)".*/\1/p' "$acf")"
  # Jogos que dependem de outro launcher (EA app, Ubisoft Connect, Rockstar) precisam abrir pela Steam,
  # onde o launcher está instalado
  [ -d "$dir/__Installer" ] || [ -f "$dir/EAStore.ini" ] || [ -n "$(find "$dir" -maxdepth 2 \( -iname 'uplay_r1_loader*.dll' \
    -o -iname 'upc_r*_loader*.dll' -o -iname 'PlayGTAV.exe' -o -iname 'Link2EA*' \) 2>/dev/null | head -1)" ] && return 1
  exe=$(game_exe "$dir")
  [ -n "$exe" ] || return 1
  case ":$(transparent_exes "$BOTTLE"):" in *":$(basename "$exe"):"*) return 1 ;; esac
  shadow=$(d3dmetal_prefix) || return 1
  key=$(unity_prefs_key "$exe")
  (
    [ -n "$key" ] && copy_reg_key "$WINE" "$WINEPREFIX" "$GPTK_WINE" "$shadow" "$key"
    start=$(date +%s)
    cd "$(dirname "$exe")" && WINEPREFIX="$shadow" "$GPTK_WINE" "$(basename "$exe")"
    WINEPREFIX="$shadow" "$GPTK_WINESERVER" -w
    if [ $(( $(date +%s) - start )) -lt 20 ]; then
      set_d3dmetal "$id" off      # não abriu: na próxima vez vai direto pela Steam
      fix_webhelper; launch_steam -applaunch "$id"
    elif [ -n "$key" ]; then
      copy_reg_key "$GPTK_WINE" "$shadow" "$WINE" "$WINEPREFIX" "$key"
    fi
  ) >/dev/null 2>&1 &
  disown
  echo "Abrindo jogo $id com o D3DMetal da Apple..."
}

# Bottles do CrossOver com Steam instalada que ainda não foram trazidos para o WinMac
cx_steam_bottles() {
  local b
  for b in "$CX_BOTTLES"/*; do
    [ -d "$b" ] && [ ! -L "$b" ] && [ -f "$b/drive_c/Program Files (x86)/Steam/steam.exe" ] && basename "$b"
  done
}

count_games() { ls "$1/drive_c/Program Files (x86)/Steam/steamapps/"appmanifest_*.acf 2>/dev/null | grep -vc appmanifest_228980; }

# Move cada bottle do CrossOver com Steam para ~/winmac/Bottles, deixando um atalho no lugar antigo
# (o CrossOver continua achando ele). Jogos, saves e o login da Steam vêm junto.
import_crossover() {
  local names name dest n=0
  names=$(cx_steam_bottles)
  [ -n "$names" ] || { echo "Nenhuma Steam do CrossOver encontrada."; return 1; }
  if pgrep -f "CrossOver.app/" >/dev/null; then
    echo "Fechando o CrossOver..."
    osascript -e 'quit app "CrossOver"' >/dev/null 2>&1
    for name in $names; do
      WINEPREFIX="$CX_BOTTLES/$name" /Applications/CrossOver.app/Contents/SharedSupport/CrossOver/bin/wineserver -k 2>/dev/null
    done
    for i in $(seq 1 15); do pgrep -f "CrossOver.app/" >/dev/null || break; sleep 1; done
    pgrep -f "CrossOver.app/.*wineserver" >/dev/null && { echo "Não consegui fechar o CrossOver. Feche ele e tente de novo."; return 1; }
  fi
  mkdir -p "$HOME_DIR/Bottles"
  while IFS= read -r name; do
    dest="$name"; [ -e "$HOME_DIR/Bottles/$dest" ] && dest="$name (CrossOver)"
    echo "Trazendo '$name' do CrossOver..."
    mv "$CX_BOTTLES/$name" "$HOME_DIR/Bottles/$dest" && ln -s "$HOME_DIR/Bottles/$dest" "$CX_BOTTLES/$name" || continue
    ( setup_env "$dest" )   # guarda as DLLs do CrossOver e instala o DXVK
    echo "Pronto: '$dest' com $(count_games "$HOME_DIR/Bottles/$dest") jogo(s)."
    n=$((n + 1))
  done <<< "$names"
  [ $n -gt 0 ]
}

steam_apps() { echo "$(bottle_path "$1")/drive_c/Program Files (x86)/Steam/steamapps"; }

case "$1" in
  detect)
    cx_steam_bottles | while IFS= read -r b; do printf "%s\t%s\n" "$b" "$(count_games "$CX_BOTTLES/$b")"; done ;;
  import)
    install_wine
    import_crossover && echo "Steam do CrossOver importada! Clique em Abrir Steam." ;;
  setup)
    name="${2:-$DEFAULT_BOTTLE}"
    install_wine
    # Se já existe uma Steam no CrossOver, usa ela (com jogos, saves e login) em vez de instalar outra
    if [ -n "$(cx_steam_bottles)" ] && ! steam_installed "$name"; then
      import_crossover && { echo "Steam do CrossOver importada! Clique em Abrir Steam."; exit 0; }
    fi
    if steam_installed "$name"; then echo "A Steam já está instalada no bottle '$name'."; exit 0; fi
    mkdir -p "$HOME_DIR/Bottles/$name"
    setup_env "$name"
    echo "Criando o bottle '$name'..."
    "$WINE" wineboot --init >/dev/null 2>&1
    "$WINESERVER" -w
    echo "Baixando a Steam oficial da Valve..."
    curl -fL# -o "$WINEPREFIX/drive_c/SteamSetup.exe" "$STEAM_SETUP_URL" || { echo "Falha ao baixar a Steam."; exit 1; }
    echo "Instalando a Steam..."
    "$WINE" 'C:\SteamSetup.exe' /S >/dev/null 2>&1
    "$WINESERVER" -w
    rm -f "$WINEPREFIX/drive_c/SteamSetup.exe"
    configure_bottle
    steam_installed "$name" && echo "Steam instalada! Clique em Abrir Steam." || { echo "A instalação da Steam falhou."; exit 1; } ;;
  list)
    for b in "$HOME_DIR/Bottles"/* "$CX_BOTTLES"/*; do
      [ -d "$b" ] && [ ! -L "$b" ] || continue
      echo "== Bottle: $(basename "$b")"
      for f in "$b/drive_c/Program Files (x86)/Steam/steamapps/"appmanifest_*.acf; do
        [ -f "$f" ] || continue
        id=$(sed -n 's/.*"appid"[[:space:]]*"\([0-9]*\)".*/\1/p' "$f")
        nm=$(sed -n 's/.*"name"[[:space:]]*"\(.*\)".*/\1/p' "$f")
        printf "   %-10s %s\n" "$id" "$nm"
      done
    done ;;
  steam)
    setup_env "$2"
    fix_webhelper
    BOTTLE="$2"; launch_steam; echo "Steam abrindo..." ;;
  play)
    setup_env "$3"
    id="$2"
    if ! [[ "$id" =~ ^[0-9]+$ ]]; then
      f=$(grep -il "\"name\".*$id" "$(steam_apps "$3")"/appmanifest_*.acf | head -1)
      id=$(sed -n 's/.*"appid"[[:space:]]*"\([0-9]*\)".*/\1/p' "$f")
    fi
    [ -n "$id" ] || { echo "Jogo não encontrado. Use: winmac list"; exit 1; }
    BOTTLE="$3"
    play_d3dmetal "$id" && exit 0
    fix_webhelper
    launch_steam -applaunch "$id"; echo "Abrindo jogo $id..." ;;
  d3dmetal)
    [[ "$2" =~ ^[0-9]+$ ]] && [[ "$3" =~ ^(on|off)$ ]] || { echo "Uso: winmac d3dmetal <appid> on|off"; exit 1; }
    set_d3dmetal "$2" "$3"; echo "D3DMetal $3 para o jogo $2." ;;
  run)
    setup_env "$3"
    nohup "$WINE" "$2" >/dev/null 2>&1 & ;;
  kill)
    export WINEPREFIX="$(bottle_path "$2")"; "$WINESERVER" -k; echo "Bottle fechado." ;;
  migrate)
    name="${2:-$DEFAULT_BOTTLE}"; src="$CX_BOTTLES/$name"
    [ -d "$src" ] && [ ! -L "$src" ] || { echo "Nada para migrar em $src"; exit 1; }
    pgrep -f "CrossOver.app/.*wineserver" >/dev/null && { echo "Feche o CrossOver primeiro."; exit 1; }
    mkdir -p "$HOME_DIR/Bottles" && mv "$src" "$HOME_DIR/Bottles/$name" && ln -s "$HOME_DIR/Bottles/$name" "$src"
    echo "Bottle '$name' agora mora em ~/winmac/Bottles (o CrossOver ainda acha ele pelo atalho)." ;;
  restore)
    p="$(bottle_path "$2")"; cp "$HOME_DIR/backup/"{system,user,userdef}.reg "$p/" && echo "Registro restaurado." ;;
  *)
    sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
