#!/bin/bash
# winmac — roda seus jogos Windows no Mac com o Wine Staging (grátis, open source).
# Uso:
#   winmac setup [bottle]     instala o Wine (se faltar) e a Steam oficial num bottle novo
#   winmac list               lista bottles e jogos da Steam
#   winmac steam [bottle]     abre a Steam
#   winmac play <appid|nome>  abre um jogo direto pelo .exe, sem a Steam (com o D3DMetal da Apple, se o Game Porting Toolkit estiver instalado)
#   winmac d3dmetal <appid> on|off   liga/desliga o D3DMetal num jogo
#   winmac ubisoft [bottle]   abre o Ubisoft Connect (no motor do CrossOver: no Wine Staging ele cai)
#   winmac run <exe> [bottle] roda qualquer .exe
#   winmac add <pasta|exe> [bottle] adiciona um programa à lista do app e abre
#   winmac detect             lista bottles do CrossOver que têm Steam (nome<TAB>nº de jogos)
#   winmac import             traz para o WinMac todos os bottles do CrossOver que têm Steam (jogos, saves, login)
#   winmac migrate [bottle]   move o bottle do CrossOver para ~/winmac/Bottles (deixa atalho de volta)
#   winmac kill [bottle]      fecha tudo que está rodando no bottle
#   winmac logs               abre a pasta com os erros dos jogos (~/winmac/logs) para mandar ao suporte
#   winmac wallpaper [on|off] papel de parede animado do Wallpaper Engine sem a Steam, desde o login
#   winmac fg [off|2x|3x|4x]  quadros extras nos jogos, no lugar do Lossless Scaling (Control+Option+S no jogo)
#   winmac restore [bottle]   restaura o registro original do CrossOver (backup)
#   winmac update [app]       baixa a versão mais nova do comando, das ferramentas e do app (se passar o caminho)

# O Wine fica em /Applications ou, sem permissão de gravar lá, em ~/Applications (WINMAC_APPS escolhe outra pasta)
# Apps .NET (ex.: LuaTools) sob o Wine:
#  - o .NET do Mac (Homebrew) define DOTNET_ROOT, e o app procura o runtime nessa pasta do Mac, não no do bottle;
#  - o log no EventLog do Windows precisa de uma DLL que não vem nesses apps (System.Threading.AccessControl)
#    e o app fecha logo ao abrir: desliga esse log.
unset DOTNET_ROOT DOTNET_ROOT_X64 DOTNET_ROOT_X86 DOTNET_ROOT_ARM64
export Logging__EventLog__LogLevel__Default=None
APP_DIRS=("/Applications" "$HOME/Applications")
[ -n "$WINMAC_APPS" ] && APP_DIRS=("$WINMAC_APPS")
use_wine_dir() {
  WINE="$1/Wine Staging.app/Contents/Resources/wine/bin/wine"
  WINESERVER="$1/Wine Staging.app/Contents/Resources/wine/bin/wineserver"
}
use_wine_dir "${APP_DIRS[0]}"
for d in "${APP_DIRS[@]}"; do [ -x "$d/Wine Staging.app/Contents/Resources/wine/bin/wine" ] && { use_wine_dir "$d"; break; }; done
HOME_DIR="$HOME/winmac"
# Logs dos jogos: só os erros do Wine (sem os avisos "fixme", que são milhares). Para mandar ao suporte.
LOG_DIR="$HOME_DIR/logs"
GAME_WINEDEBUG="fixme-all"
CX_BOTTLES="$HOME/Library/Application Support/CrossOver/Bottles"
DEFAULT_BOTTLE="Steam"
STEAM_EXE='C:\Program Files (x86)\Steam\steam.exe'
# -noverifyfiles: impede a Steam de desfazer o embrulho do steamwebhelper (ver fix_webhelper)
STEAM_ARGS=(-noverifyfiles)
WRAP_EXE="$HOME_DIR/tools/steamwebhelper-wrap.exe"
WEBHELPER_FLAGS="--disable-gpu --disable-gpu-compositing --in-process-gpu --disable-features=CalculateNativeWinOcclusion --disable-direct-composition"

bottle_path() {
  local name="${1:-$DEFAULT_BOTTLE}"
  if [ -d "$HOME_DIR/Bottles/$name" ]; then echo "$HOME_DIR/Bottles/$name"
  else echo "$CX_BOTTLES/$name"; fi
}

# DLLs que o CrossOver coloca no bottle e que derrubam o Wine comum (ex.: steamwebhelper.exe trava).
# Ficam guardadas em ~/winmac/crossover-dlls/<bottle> para poder devolver.
CX_DLLS=(system32/atidxx64.dll system32/nvapi64.dll system32/nvngx.dll system32/nvngx-on-metalfx.dll
         system32/winemetal.dll system32/wpcap.dll syswow64/winemetal.dll syswow64/wpcap.dll)
set_aside_crossover_dlls() {
  local win="$1/drive_c/windows" dest="$HOME_DIR/crossover-dlls/$(basename "$1")" f
  # Uma vez só por bottle: o DXMT instala depois um winemetal.dll e um nvapi64.dll com o mesmo nome
  [ -f "$1/.winmac-cx-dlls" ] && return 0
  for f in "${CX_DLLS[@]}"; do
    [ -f "$win/$f" ] || continue
    mkdir -p "$dest/$(dirname "$f")" && mv "$win/$f" "$dest/$f"
  done
  touch "$1/.winmac-cx-dlls"
}

setup_env() {
  export WINEPREFIX="$(bottle_path "$1")"
  export WINEESYNC=1
  export WINEDEBUG=-all
  export MTL_HUD_ENABLED="${MTL_HUD_ENABLED:-0}"
  # Bottles do CrossOver usam o usuário Windows "crossover"; mantém o mesmo para os saves continuarem no lugar
  [ -d "$WINEPREFIX/drive_c/users/crossover" ] && export USER=crossover
  install_wine
  [ -d "$WINEPREFIX" ] || { echo "Bottle não encontrado: $WINEPREFIX"; exit 1; }
  set_aside_crossover_dlls "$WINEPREFIX"
  if pgrep -f "CrossOver.app/.*wineserver" >/dev/null; then
    echo "O CrossOver está rodando. Feche a Steam/CrossOver antes de usar o winmac no mesmo bottle."; exit 1
  fi
  ensure_tools
  configure_bottle
  install_dxmt
  # Camada Vulkan dos jogos de 32 bits (ver vk32_for_exe); não muda nada nos de 64 bits
  [ -f "$HOME_DIR/tools/winmac-vk32.json" ] && export VK_ADD_IMPLICIT_LAYER_PATH="$HOME_DIR/tools"
}

WINE_URL="https://github.com/Gcenx/macOS_Wine_builds/releases/download/11.18/wine-staging-11.18-osx64.tar.xz"
DXVK_URL="https://github.com/Gcenx/DXVK-macOS/releases/download/v1.10.3-20230507-repack/dxvk-macOS-async-v1.10.3-20230507-repack.tar.gz"
STEAM_SETUP_URL="https://cdn.cloudflare.steamstatic.com/client/installer/SteamSetup.exe"

# Os Macs com chip Apple precisam do Rosetta 2 para rodar o Wine (pede a senha numa janela, se precisar)
ensure_rosetta() {
  [ "$(uname -m)" = arm64 ] || return 0
  arch -x86_64 /usr/bin/true 2>/dev/null && return 0
  echo "Instalando o Rosetta 2..."
  softwareupdate --install-rosetta --agree-to-license >/dev/null 2>&1 ||
    osascript -e 'do shell script "softwareupdate --install-rosetta --agree-to-license" with administrator privileges' >/dev/null 2>&1
  arch -x86_64 /usr/bin/true 2>/dev/null || {
    echo "Não consegui instalar o Rosetta 2. Rode no Terminal: softwareupdate --install-rosetta --agree-to-license"; exit 1; }
}

install_wine() {
  ensure_rosetta
  [ -x "$WINE" ] && return 0
  echo "Baixando o Wine Staging (só na primeira vez)..."
  local tmp d; tmp=$(mktemp -d)
  curl -fL# --retry 3 "$WINE_URL" | tar -xJf - -C "$tmp" || { echo "Falha ao baixar o Wine. Confira a internet e tente de novo."; exit 1; }
  for d in "${APP_DIRS[@]}"; do
    mkdir -p "$d" 2>/dev/null
    if mv "$tmp/Wine Staging.app" "$d/" 2>/dev/null; then
      xattr -dr com.apple.quarantine "$d/Wine Staging.app" 2>/dev/null
      use_wine_dir "$d"
      break
    fi
  done
  rmdir "$tmp" 2>/dev/null
  "$WINE" --version >/dev/null 2>&1 || { echo "Falha ao instalar o Wine."; exit 1; }
}

# Ferramentas do WinMac que faltarem vêm da última versão publicada
latest_tag() {
  curl -fsL --max-time 30 "https://api.github.com/repos/Yohotaco/winmac/releases/latest" |
    sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1
}
ensure_tools() {
  local f tag tmp
  for f in tools/steamwebhelper-wrap.exe tools/winmac-transparent.dylib tools/winmac-dxmt.dylib tools/winmac-progman.exe tools/lossless-wrap.exe tools/winmac-vk32.dylib tools/winmac-vk32.json; do
    [ -f "$HOME_DIR/$f" ] && continue
    [ -n "$tag" ] || tag=$(latest_tag)
    [ -n "$tag" ] || return 0
    mkdir -p "$HOME_DIR/tools"; tmp=$(mktemp)
    curl -fsL --max-time 60 -o "$tmp" "https://raw.githubusercontent.com/Yohotaco/winmac/$tag/$f" &&
      chmod 755 "$tmp" && mv "$tmp" "$HOME_DIR/$f"
  done
}

# DXVK (DirectX 10/11 -> Vulkan/Metal): sem ele os jogos DX11 falham com "Failed to initialize graphics"
install_dxvk() {
  local cache="$HOME_DIR/dxvk" src d
  src=$(ls -d "$cache"/dxvk-macOS-* 2>/dev/null | head -1)
  if [ -z "$src" ]; then
    echo "Baixando o DXVK..."
    mkdir -p "$cache" && curl -fsL "$DXVK_URL" | tar -xz -C "$cache" || { echo "Falha ao baixar o DXVK."; return 1; }
    src=$(ls -d "$cache"/dxvk-macOS-* | head -1)
  fi
  for d in d3d11 d3d10core; do
    cp "$src/x64/$d.dll" "$WINEPREFIX/drive_c/windows/system32/"
    cp "$src/x32/$d.dll" "$WINEPREFIX/drive_c/windows/syswow64/"
    "$WINE" reg add 'HKCU\Software\Wine\DllOverrides' /v $d /t REG_SZ /d native,builtin /f >/dev/null 2>&1
  done
}

# Ajustes feitos uma vez por bottle
configure_bottle() {
  [ -f "$WINEPREFIX/.winmac-ok" ] && return 0
  [ -d "$WINEPREFIX/drive_c/windows/system32" ] || return 0   # bottle ainda vazio (winmac setup)
  install_dxvk || return 1
  "$WINE" reg add 'HKCU\Software\Wine\WineDbg' /v ShowCrashDialog /t REG_DWORD /d 0 /f >/dev/null 2>&1
  touch "$WINEPREFIX/.winmac-ok"
}

steam_installed() { [ -f "$(bottle_path "$1")/drive_c/Program Files (x86)/Steam/steam.exe" ]; }

# A janela da Steam fica preta no Wine do macOS porque o navegador interno (steamwebhelper)
# desenha pela GPU. O embrulho chama o steamwebhelper original com opções do Chromium para
# desenhar por software. Se a Steam se atualizar e trocar o arquivo, ele é reaplicado aqui.
fix_webhelper() {
  local dir="$WINEPREFIX/drive_c/Program Files (x86)/Steam/bin/cef/cef.win64"
  local exe="$dir/steamwebhelper.exe" real="$dir/steamwebhelper_real.exe" rsize
  [ -f "$exe" ] && [ -f "$WRAP_EXE" ] || return 0
  # O embrulho fica com o mesmo tamanho do original (completado com zeros): a Steam só confere o tamanho
  # dos arquivos, então não desfaz o embrulho nem quando é aberta sem -noverifyfiles (ex.: pelo LuaTools).
  # É o original da Steam se tem conteúdo depois do 1º MB (o embrulho tem ~150 KB e o resto é zero).
  if [ "$(stat -f%z "$exe")" -gt 1000000 ] && [ "$(tail -c +1000001 "$exe" | tr -d '\0' | head -c 1 | wc -c)" -gt 0 ]; then
    mv -f "$exe" "$real"
  fi
  [ -f "$real" ] || return 0
  rsize=$(stat -f%z "$real")
  if ! cmp -s "$WRAP_EXE" <(head -c "$(stat -f%z "$WRAP_EXE")" "$exe" 2>/dev/null) || [ "$(stat -f%z "$exe" 2>/dev/null)" != "$rsize" ]; then
    cp "$WRAP_EXE" "$exe.tmp" && dd if=/dev/zero of="$exe.tmp" bs=1 count=0 seek="$rsize" 2>/dev/null && mv -f "$exe.tmp" "$exe"
  fi
  echo "$WEBHELPER_FLAGS" > "$dir/winmac_flags.txt"
}

# Jogos "overlay" (fundo transparente por cima da área de trabalho) usam DwmExtendFrameIntoClientArea,
# que o Wine do macOS não implementa: o fundo fica preto. O winmac-transparent.dylib é carregado nos
# processos do Wine e deixa a janela desses jogos transparente. A lista é montada procurando, nos jogos
# Unity instalados, o uso de DwmExtendFrameIntoClientArea.
# Programas como o LuaTools reabrem a Steam sozinhos, sem o -noverifyfiles. Se a Steam se atualizar e trouxer
# um steamwebhelper novo, ele roda sem o embrulho e a tela fica preta. Esta guarda roda em segundo plano
# enquanto o Wine estiver aberto: se o original voltar, recoloca o embrulho e fecha o webhelper (a Steam o
# reabre já embrulhado).
guard_webhelper() {
  [ -f "$WRAP_EXE" ] && [ -d "$WINEPREFIX/drive_c/Program Files (x86)/Steam" ] || return 0
  local pidfile="$WINEPREFIX/.winmac-guard.pid"
  [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null && return 0
  (
    trap 'rm -f "$pidfile"' EXIT
    idle=0
    while [ "$idle" -lt 20 ]; do
      sleep 3
      if pgrep -x wineserver >/dev/null; then idle=0; else idle=$((idle+1)); continue; fi
      fix_webhelper
      fix_lossless
      # O log da Steam não passa de 20 MB (ela é aberta com >>, então zerar o arquivo funciona)
      [ "$(stat -f%z "$LOG_DIR/steam.log" 2>/dev/null || echo 0)" -gt 20000000 ] && : > "$LOG_DIR/steam.log"
      if pgrep -f 'cef\.win64\\steamwebhelper\.exe --type=' >/dev/null; then
        pkill -f 'cef\.win64\\steamwebhelper'
        sleep 5
      fi
    done
  ) >/dev/null 2>&1 &
  echo $! > "$pidfile"
  disown
}

DXMT_DYLIB="$HOME_DIR/tools/winmac-dxmt.dylib"
TRANSPARENT_DYLIB="$HOME_DIR/tools/winmac-transparent.dylib"
transparent_exes() {
  local common="$(steam_apps "$1")/common" dll dir exes=""
  for dll in "$common"/*/*_Data/Managed/Assembly-CSharp.dll; do
    [ -f "$dll" ] && grep -q -a "DwmExtendFrameIntoClientArea" "$dll" || continue
    dir=$(dirname "$(dirname "$dll")")              # .../Jogo_Data
    exes="$exes:$(basename "${dir%_Data}").exe"
  done
  echo "${exes#:}"
}

# DXMT (DirectX 10/11 -> Metal, código aberto: github.com/3Shain/dxmt). Mais rápido que o DXVK porque não
# passa pelo Vulkan/MoltenVK. Os arquivos ficam em ~/winmac/dxmt/<versão> e são copiados para a pasta do Wine
# e para o bottle sempre que faltam (também depois de o Wine recriar as DLLs do bottle).
DXMT_URL="https://github.com/3Shain/dxmt/releases/download/v0.80/dxmt-v0.80-builtin.tar.gz"
sync_dir() {  # copia só os arquivos que mudaram (um jogo pode estar usando as DLLs)
  local f
  for f in "$1"/*; do
    cmp -s "$f" "$2/$(basename "$f")" || cp "$f" "$2/" || return 1
  done
}
install_dxmt() {
  local src win="$WINEPREFIX/drive_c/windows" lib="$(dirname "$WINE")/../lib/wine" d
  src=$(ls -d "$HOME_DIR"/dxmt/v* 2>/dev/null | sort -V | tail -1)
  if [ -z "$src" ]; then
    mkdir -p "$HOME_DIR/dxmt" && curl -fsL "$DXMT_URL" | tar -xz -C "$HOME_DIR/dxmt" || return 1
    src=$(ls -d "$HOME_DIR"/dxmt/v* | sort -V | tail -1)
  fi
  [ -f "$DXMT_DYLIB" ] && [ -d "$win/system32" ] || return 0
  # Sem permissão na pasta do Wine: o bottle continua no DXVK
  sync_dir "$src/x86_64-unix" "$lib/x86_64-unix" && sync_dir "$src/x86_64-windows" "$lib/x86_64-windows" &&
    sync_dir "$src/i386-windows" "$lib/i386-windows" || return 1
  sync_dir "$src/x86_64-windows" "$win/system32" && sync_dir "$src/i386-windows" "$win/syswow64"
  if [ ! -f "$WINEPREFIX/.winmac-dxmt" ]; then
    for d in d3d11 d3d10core dxgi winemetal; do
      "$WINE" reg add 'HKCU\Software\Wine\DllOverrides' /v $d /t REG_SZ /d native,builtin /f >/dev/null 2>&1
    done
    touch "$WINEPREFIX/.winmac-dxmt"
  fi
}

# Jogos DirectX 9 (e 8, DirectDraw) de 32 bits travam ao abrir em 3 a 5 de cada 10 vezes, com a janela
# branca: no Mac com chip Apple, a troca do modo 32 para o 64 bits do Rosetta falha durante a preparação do
# OpenGL (bug 60494 do Wine, em todas as versões testadas, 11.0 a 11.21). Com o renderizador Vulkan do Wine
# o OpenGL não é usado e o travamento some (0 em 28). O Vulkan só funciona em 32 bits com a camada
# winmac-vk32 (o MoltenVK recusa a memória do host que o Wine de 32 bits usa). Vale só para o .exe do jogo.
vk32_for_exe() {
  [ -f "$HOME_DIR/tools/winmac-vk32.json" ] && exe_is_32bit "$1" || return 0
  "$WINE" reg add "HKCU\\Software\\Wine\\AppDefaults\\$(basename "$1")\\Direct3D" /v renderer /t REG_SZ /d vulkan /f >/dev/null 2>&1
}
# Jogos da Steam: uma vez por jogo instalado (a lista dos já vistos fica no bottle)
vk32_steam_games() {
  local acf id dir exe seen="$WINEPREFIX/.winmac-vk32"
  [ -f "$HOME_DIR/tools/winmac-vk32.json" ] || return 0
  for acf in "$(steam_apps "$BOTTLE")"/appmanifest_*.acf; do
    [ -f "$acf" ] || continue
    id=$(sed -n 's/.*"appid"[[:space:]]*"\([0-9]*\)".*/\1/p' "$acf")
    grep -qx "$id" "$seen" 2>/dev/null && continue
    dir="$(steam_apps "$BOTTLE")/common/$(sed -n 's/.*"installdir"[[:space:]]*"\(.*\)".*/\1/p' "$acf")"
    exe=$(game_exe "$dir")
    [ -n "$exe" ] || continue   # ainda baixando: tenta de novo na próxima vez
    vk32_for_exe "$exe"
    echo "$id" >> "$seen"
  done
}

# Abre a Steam (com argumentos extras) já com o módulo de transparência
prepare_launch() {
  # Sobras de uma sessão do Wine que travou (processos sem wineserver) impedem a Steam de abrir
  if ! pgrep -x wineserver >/dev/null && pgrep -f '^C:\\' >/dev/null; then
    pkill -9 -f '^C:\\'
    sleep 1
  fi
  export WINMAC_TRANSPARENT_EXES="$(transparent_exes "$BOTTLE")"
  local inject=""
  # DXMT (DirectX 11 -> Metal) precisa do módulo winmac-dxmt.dylib para criar a tela Metal na janela
  [ -f "$DXMT_DYLIB" ] && inject="$DXMT_DYLIB"
  if [ -n "$WINMAC_TRANSPARENT_EXES" ] && [ -f "$TRANSPARENT_DYLIB" ]; then
    inject="${inject:+$inject:}$TRANSPARENT_DYLIB"
  fi
  [ -n "$inject" ] && export DYLD_INSERT_LIBRARIES="$inject"
  fix_wallpaper_engine
  fix_lossless
  vk32_steam_games
  guard_webhelper
}

# Wallpaper Engine:
#  1. a interface (um Chromium) fica preta com a GPU sob o Wine: o wallpaperui.exe ganha o mesmo embrulho do
#     steamwebhelper, que liga o Chromium sem GPU;
#  2. o motor espera a área de trabalho do Windows (janela "Progman") e o Wine do Mac não tem uma: o
#     winmac-progman.exe cria essa área, invisível, e o winmac-dxmt.dylib mostra o papel de parede numa
#     janela no nível do papel de parede do macOS (atrás de todas as janelas).
PROGMAN_EXE="$HOME_DIR/tools/winmac-progman.exe"
# Só os processos do Wine (a linha de comando começa com a unidade, ex.: "C:\\" ou "Z:/")
WP_PROC='^[A-Za-z]:.*wallpaper64\.exe'
PROGMAN_PROC='^[A-Za-z]:.*winmac-progman\.exe'
fix_wallpaper_engine() {
  local dir="$(steam_apps "$BOTTLE")/common/wallpaper_engine/bin"
  [ -d "$dir" ] || return 0
  if [ -f "$dir/wallpaperui.exe" ] && [ -f "$WRAP_EXE" ] && ! cmp -s "$WRAP_EXE" "$dir/wallpaperui.exe"; then
    # Só guarda como _real o original (vários MB), nunca uma versão antiga do embrulho
    [ "$(stat -f%z "$dir/wallpaperui.exe")" -gt 1000000 ] && mv -f "$dir/wallpaperui.exe" "$dir/wallpaperui_real.exe"
    cp "$WRAP_EXE" "$dir/wallpaperui.exe"
  fi
  [ -f "$dir/wallpaperui_real.exe" ] && echo "$WEBHELPER_FLAGS" > "$dir/winmac_flags.txt"
  # Sem Wallpaper Engine aberto, reinicia o auxiliar: pega a versão nova depois de uma atualização
  if pgrep -f "$PROGMAN_PROC" >/dev/null && ! pgrep -f "$WP_PROC" >/dev/null; then
    "$WINE" taskkill /F /IM winmac-progman.exe >/dev/null 2>&1
  fi
  if [ -f "$PROGMAN_EXE" ] && ! pgrep -f "$PROGMAN_PROC" >/dev/null; then
    "$WINE" "Z:$PROGMAN_EXE" >/dev/null 2>&1 &
    disown
  fi
}

# Papel de parede animado sem a Steam: o motor roda sozinho e um item de login do macOS (LaunchAgent)
# abre ele ao ligar o Mac e reabre se fechar (ex.: "Fechar tudo"). `winmac wallpaper off` desliga.
WP_AGENT="$HOME/Library/LaunchAgents/com.winmac.wallpaper.plist"
WP_OFF="$HOME_DIR/.wallpaper-off"
WE_APPID=431960
wallpaper_exe() { echo "$(steam_apps "$1")/common/wallpaper_engine/wallpaper64.exe"; }
wallpaper_agent_on() {
  mkdir -p "$(dirname "$WP_AGENT")"
  cat > "$WP_AGENT" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.winmac.wallpaper</string>
<key>ProgramArguments</key><array><string>/bin/bash</string><string>$HOME_DIR/winmac</string><string>wallpaper</string><string>run</string><string>$1</string></array>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>15</integer>
<key>AbandonProcessGroup</key><true/>
<key>StandardOutPath</key><string>$HOME_DIR/wallpaper.log</string>
<key>StandardErrorPath</key><string>$HOME_DIR/wallpaper.log</string>
</dict></plist>
EOF
  launchctl bootout "gui/$(id -u)/com.winmac.wallpaper" 2>/dev/null
  launchctl bootstrap "gui/$(id -u)" "$WP_AGENT"
}
# Chamado ao abrir a Steam: liga o item de login na primeira vez que acha o Wallpaper Engine
wallpaper_autostart() {
  [ -f "$(wallpaper_exe "$BOTTLE")" ] && [ ! -f "$WP_AGENT" ] && [ ! -f "$WP_OFF" ] && wallpaper_agent_on "$BOTTLE"
  return 0
}

launch_steam() {
  prepare_launch
  wallpaper_autostart
  # Os erros da Steam e dos jogos abertos por ela vão para ~/winmac/logs/steam.log (o anterior vira steam.old.log)
  mkdir -p "$LOG_DIR"
  if ! pgrep -f 'Steam\\steam\.exe' >/dev/null; then
    [ -f "$LOG_DIR/steam.log" ] && mv -f "$LOG_DIR/steam.log" "$LOG_DIR/steam.old.log"
  fi
  # Sem nohup: ele é um programa protegido do macOS e apagaria o DYLD_INSERT_LIBRARIES
  WINEDEBUG="$GAME_WINEDEBUG" "$WINE" "$STEAM_EXE" "${STEAM_ARGS[@]}" "$@" >> "$LOG_DIR/steam.log" 2>&1 &
  disown
}

# ---------- Programas de fora da Steam ----------
# A lista do app fica em <bottle>/.winmac-programs (nome<TAB>caminho). Atalhos criados por instaladores
# no Menu Iniciar o próprio app encontra.
NOT_MAIN='unins|setup|instal|redist|vc_|dxweb|directx|dotnet|ndp[0-9]|crash|report|helper|update|patch|prereq|easyanticheat|battleye|config|autorun'
is_installer() { basename "$1" | grep -qiE 'setup|instal|\.msi$'; }

# Escolhe o .exe principal da pasta: nome parecido com o da pasta, depois o mais raso, depois o maior
pick_exe() {
  local folder base key rel depth size match f
  folder=$(basename "$1" | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9')
  find "$1" -type f -iname '*.exe' -print0 | while IFS= read -r -d '' f; do
    base=$(basename "$f")
    printf '%s' "$base" | grep -qiE "$NOT_MAIN" && continue
    key=$(printf '%s' "${base%.*}" | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9')
    match=1
    if [ -n "$key" ] && [ -n "$folder" ]; then
      case "$folder" in *"$key"*) match=0 ;; esac
      case "$key" in *"$folder"*) match=0 ;; esac
    fi
    rel="${f#"$1"/}"
    depth=$(printf '%s' "$rel" | tr -cd '/' | wc -c | tr -d ' ')
    size=$(stat -f %z "$f")
    printf '%s\t%s\t%s\t%s\n' "$match" "$depth" "$((999999999999 - size))" "$f"
  done | sort -t "$(printf '\t')" -k1,1n -k2,2n -k3,3n | head -1 | cut -f4
}

register_program() {
  local list="$WINEPREFIX/.winmac-programs"
  grep -qF "$(printf '\t%s' "$2")" "$list" 2>/dev/null || printf '%s\t%s\n' "$1" "$2" >> "$list"
}

# Programas WPF (ex.: Bloxstrap) saem com a janela preta, só com os botões, porque o WPF desenha pela GPU.
# Pede desenho por software, uma vez por bottle.
fix_wpf() {
  [ -f "$WINEPREFIX/.winmac-wpf" ] || [ ! -f "$WINEPREFIX/system.reg" ] && return 0
  "$WINE" reg add 'HKCU\Software\Microsoft\Avalon.Graphics' /v DisableHWAcceleration /t REG_DWORD /d 1 /f >/dev/null 2>&1 &&
    touch "$WINEPREFIX/.winmac-wpf"
}

# Abre um programa na pasta dele. Com "wait", só volta quando ele fechar (instaladores).
# Com um arquivo no 3º argumento, os erros do Wine vão para ele (logs dos jogos).
run_program() {
  local file ext cmd log="${3:-/dev/null}" dbg="$WINEDEBUG"
  [ -n "$3" ] && dbg="$GAME_WINEDEBUG"
  file=$(basename "$1"); ext=$(printf '%s' "${1##*.}" | tr 'A-Z' 'a-z')
  fix_wpf
  prepare_launch
  [ "$ext" = exe ] && vk32_for_exe "$1"
  cd "$(dirname "$1")" || { echo "Não encontrei a pasta de $file."; exit 1; }
  case "$ext" in
    msi) cmd=("$WINE" msiexec /i "$file") ;;
    bat|cmd) cmd=("$WINE" cmd /c "$file") ;;
    lnk) cmd=("$WINE" start /unix "$1") ;;
    *) cmd=("$WINE" "$1") ;;
  esac
  if [ "$2" = wait ]; then
    "${cmd[@]}" >/dev/null 2>&1
  else
    WINEDEBUG="$dbg" "${cmd[@]}" > "$log" 2>&1 &
    disown
  fi
}

run_installer() {
  echo "Instalador aberto: siga os passos na janela dele."
  run_program "$1" wait
  echo "Instalador fechado. O programa instalado aparece aqui se ele criou um atalho."
}

# Arrastar para o app: pasta (copia para o C: e abre o .exe principal), .exe solto (abre onde está)
# ou instalador (abre e o programa instalado aparece sozinho). Nunca sobrescreve uma pasta existente.
add_program() {
  local src="${1%/}" bottle="${2:-$DEFAULT_BOTTLE}" ext main inst name dest n=2
  [ -e "$src" ] || { echo "Não encontrei: $src"; exit 1; }
  if [ -f "$src" ]; then
    ext=$(printf '%s' "${src##*.}" | tr 'A-Z' 'a-z')
    case "$ext" in
      exe|msi|bat|cmd) ;;
      *) echo "O WinMac abre pastas e arquivos .exe, .msi ou .bat. Se estiver em .zip ou .rar, descompacte antes."; exit 1 ;;
    esac
  fi
  [ -d "$(bottle_path "$bottle")" ] || mkdir -p "$HOME_DIR/Bottles/$bottle"
  setup_env "$bottle"
  BOTTLE="$bottle"
  if [ ! -f "$WINEPREFIX/system.reg" ]; then
    echo "Preparando o Windows (só na primeira vez)..."
    "$WINE" wineboot --init >/dev/null 2>&1
    "$WINESERVER" -w
    configure_bottle
    install_dxmt
  fi
  if [ -f "$src" ]; then
    if is_installer "$src"; then run_installer "$src"; return; fi
    name=$(basename "$src"); name="${name%.*}"
    register_program "$name" "$src"
    echo "Abrindo $name..."
    run_program "$src"
    return
  fi
  main=$(pick_exe "$src")
  if [ -z "$main" ]; then
    inst=$(find "$src" -type f \( -iname '*setup*.exe' -o -iname '*instal*.exe' -o -iname '*.msi' \) ! -iname 'unins*' | awk '{ print length, $0 }' | sort -n | head -1 | cut -d' ' -f2-)
    [ -n "$inst" ] || { echo "Não achei nenhum programa do Windows nessa pasta."; exit 1; }
    run_installer "$inst"
    return
  fi
  name=$(basename "$src")
  case "$src" in
    "$WINEPREFIX"/*) dest="$src" ;;
    *)
      dest="$WINEPREFIX/drive_c/Games/$name"
      while [ -e "$dest" ]; do dest="$WINEPREFIX/drive_c/Games/$name $n"; n=$((n + 1)); done
      mkdir -p "$WINEPREFIX/drive_c/Games"
      echo "Copiando $name para o WinMac..."
      # -c: no mesmo disco não ocupa espaço dobrado
      cp -cR "$src" "$dest" 2>/dev/null || ditto "$src" "$dest" || { echo "Não deu para copiar $name. Confira o espaço livre no disco."; exit 1; }
      main="$dest/${main#"$src"/}"
      name=$(basename "$dest")
      ;;
  esac
  register_program "$name" "$main"
  echo "Abrindo $name..."
  run_program "$main"
}

# ---------- D3DMetal (Game Porting Toolkit da Apple) ----------
# O D3DMetal traduz DirectX 11/12 direto para Metal e é bem mais rápido que o DXVK (ex.: Internet Cafe
# Simulator: 22 → 89 FPS no M2). Ele só funciona no Wine do Game Porting Toolkit, que não roda a Steam;
# por isso a Steam continua no Wine Staging e o jogo abre direto no Wine do GPTK, num bottle-sombra
# (~/winmac/Bottles/.d3dmetal-<bottle>) que usa a mesma pasta de usuário (saves em arquivo) e copia as
# configurações/saves do Unity (registro) na ida e na volta. Se o jogo fechar logo, o WinMac abre o .exe
# no Wine Staging (play_direct) e lembra disso para a próxima vez.
GPTK_DIR="/Applications/Game Porting Toolkit.app/Contents/Resources/wine"
GPTK_WINE="$GPTK_DIR/bin/wine64"
GPTK_WINESERVER="$GPTK_DIR/bin/wineserver"
D3DM_OFF="$HOME_DIR/d3dmetal-off"   # appids que não abrem com o D3DMetal

has_d3dmetal() { [ -x "$GPTK_WINE" ] && [ -d "$GPTK_DIR/lib/external/D3DMetal.framework" ]; }
# .exe de 32 bits: o cabeçalho PE (endereço no byte 0x3C) diz a máquina, 0x14c = i386
exe_is_32bit() {
  local off
  off=$(od -An -tu4 -j60 -N4 "$1" 2>/dev/null | tr -d ' ')
  [ -n "$off" ] && [ "$(od -An -tx2 -j$((off + 4)) -N2 "$1" 2>/dev/null | tr -d ' ')" = 014c ]
}
# Jogo aberto pelo D3DMetal travado (ex.: parado na tela de carregamento): o "Fechar tudo" fecha ele também
# e marca o jogo para abrir no Wine Staging na próxima vez
kill_d3dmetal() {
  local shadow="$HOME_DIR/Bottles/.d3dmetal-$(basename "$WINEPREFIX")" id
  [ -x "$GPTK_WINESERVER" ] && [ -d "$shadow" ] || return 0
  if [ -f "$shadow/.winmac-playing" ]; then
    id=$(cat "$shadow/.winmac-playing")
    touch "$shadow/.winmac-killed"
    [ -n "$id" ] && set_d3dmetal "$id" off
  fi
  WINEPREFIX="$shadow" "$GPTK_WINESERVER" -k 2>/dev/null
}
d3dmetal_off() { grep -qx "$1" "$D3DM_OFF" 2>/dev/null; }
set_d3dmetal() {
  touch "$D3DM_OFF"; grep -vx "$1" "$D3DM_OFF" > "$D3DM_OFF.tmp"; mv "$D3DM_OFF.tmp" "$D3DM_OFF"
  [ "$2" = off ] && echo "$1" >> "$D3DM_OFF"
}

# .exe principal do jogo: o do Unity (tem a pasta <nome>_Data) ou o maior .exe que não é instalador/ajudante
game_exe() {
  local dir="$1" e best
  while IFS= read -r e; do
    [ -d "${e%.exe}_Data" ] && { echo "$e"; return; }
  done < <(find "$dir" -maxdepth 3 -iname '*.exe' 2>/dev/null)
  best=$(find "$dir" -maxdepth 3 -iname '*.exe' 2>/dev/null \
    | grep -viE 'unitycrashhandler|trial|demo|unins|setup|instal|redist|vcredist|dxsetup|crashreport|easyanticheat|battleye|_be\.exe|_real\.exe' \
    | while IFS= read -r e; do echo "$(stat -f %z "$e") $e"; done | sort -rn | head -1 | cut -d' ' -f2-)
  echo "$best"
}

# Pasta de um jogo da Steam instalado (vazio se o appid não está instalado no bottle)
steam_game_dir() {
  local acf="$(steam_apps "$BOTTLE")/appmanifest_$1.acf"
  [ -f "$acf" ] || return 1
  echo "$(steam_apps "$BOTTLE")/common/$(sed -n 's/.*"installdir"[[:space:]]*"\(.*\)".*/\1/p' "$acf")"
}

# Jogos da Steam abertos direto pelo .exe: sem o steam_appid.txt ao lado do .exe, os jogos com Steamworks
# fecham e se reabrem pela Steam. Com ele o jogo segue sozinho; se precisar da Steam (DRM, conquistas,
# multiplayer), é só abrir a Steam antes que o jogo se conecta a ela.
no_steam_restart() {
  local f="$(dirname "$1")/steam_appid.txt"
  [ -f "$f" ] || printf '%s\n' "$2" > "$f"
}

# Abre o jogo da Steam no Wine Staging, direto pelo .exe (como o "winmac run"). Retorna 1 se não achou o .exe.
play_direct() {
  local id="$1" dir exe
  if [ "$id" = "$WE_APPID" ]; then exe=$(wallpaper_exe "$BOTTLE")   # o motor, não a interface
  else dir=$(steam_game_dir "$id") && exe=$(game_exe "$dir"); fi
  [ -f "$exe" ] || return 1
  no_steam_restart "$exe" "$id"
  mkdir -p "$LOG_DIR"
  run_program "$exe" "" "$LOG_DIR/$id.log"
  echo "Abrindo $(basename "$exe")..."
}

# Chave do registro onde o Unity guarda configurações e saves (PlayerPrefs)
unity_prefs_key() {
  local info="${1%.exe}_Data/app.info" company product
  [ -f "$info" ] || return 1
  company=$(sed -n 1p "$info" | tr -d '\r'); product=$(sed -n 2p "$info" | tr -d '\r')
  [ -n "$company" ] && [ -n "$product" ] && echo "HKCU\\Software\\$company\\$product"
}

# Copia uma chave do registro de um bottle para outro (apaga a antiga no destino antes)
copy_reg_key() {  # <wine origem> <prefixo origem> <wine destino> <prefixo destino> <chave>
  # Copia o trecho da chave direto entre os user.reg, só se o da origem for mais novo.
  # NÃO use "reg export/import": o Wine corta os floats do Unity (8 bytes num REG_DWORD)
  # pela metade e perde chaves — o save do ICS voltava com 0$ e itens fora do lugar.
  local src="$2/user.reg" dst="$4/user.reg" sts dts lock
  [ -f "$src" ] && [ -f "$dst" ] || return 1
  export WINMAC_REG_HDR="[$(printf '%s' "${5#HKCU\\}" | sed 's/\\/\\\\/g')] "
  reg_key_time() { awk 'index($0, ENVIRON["WINMAC_REG_HDR"]) == 1 { print $NF; exit }' "$1"; }
  sts=$(reg_key_time "$src"); [ -n "$sts" ] || return 1
  dts=$(reg_key_time "$dst")
  [ -n "$dts" ] && [ "$dts" -ge "$sts" ] && return 0
  # Com o wineserver do destino aberto, ele regravaria o user.reg da memória
  lock="/tmp/.wine-$(id -u)/server-$(printf '%x-%x' $(stat -f '%d %i' "$4"))/lock"
  [ -f "$lock" ] && lsof -t "$lock" >/dev/null 2>&1 && return 0
  awk 'index($0, ENVIRON["WINMAC_REG_HDR"]) == 1 { on = 1 } on { print } on && $0 == "" { exit }' "$src" > "$dst.winmac-key" || return 1
  awk -v keyfile="$dst.winmac-key" '
    function put() { while ((getline l < keyfile) > 0) print l; done = 1 }
    index($0, ENVIRON["WINMAC_REG_HDR"]) == 1 { put(); skip = 1; next }
    skip { if ($0 == "") skip = 0; next }
    { print }
    END { if (!done) { print ""; put() } }' "$dst" > "$dst.winmac-tmp" || return 1
  cp -p "$dst" "$dst.winmac-bak" && mv -f "$dst.winmac-tmp" "$dst"
  rm -f "$dst.winmac-key"
}

# Bottle-sombra do GPTK, que divide a pasta de usuário (AppData, Documentos) com o bottle da Steam
d3dmetal_prefix() {
  local shadow="$HOME_DIR/Bottles/.d3dmetal-$(basename "$WINEPREFIX")" u="$USER"
  if [ ! -d "$shadow/drive_c/windows" ]; then
    echo "Preparando o D3DMetal (só na primeira vez)..." >&2
    WINEPREFIX="$shadow" "$GPTK_WINE" wineboot -i >/dev/null 2>&1
    WINEPREFIX="$shadow" "$GPTK_WINESERVER" -w
  fi
  if [ -d "$WINEPREFIX/drive_c/users/$u" ] && [ ! -L "$shadow/drive_c/users/$u" ]; then
    rm -rf "$shadow/drive_c/users/$u" && ln -s "$WINEPREFIX/drive_c/users/$u" "$shadow/drive_c/users/$u"
  fi
  echo "$shadow"
}

# Abre o jogo com o D3DMetal; volta para o Wine Staging se não der. Retorna 1 se nem tentou.
play_d3dmetal() {
  local id="$1" dir exe key shadow
  has_d3dmetal && ! d3dmetal_off "$id" && [ "$id" != "$WE_APPID" ] || return 1
  dir=$(steam_game_dir "$id") || return 1
  # Jogos que dependem de outro launcher (EA app, Ubisoft Connect, Rockstar) precisam abrir no bottle
  # da Steam, onde o launcher está instalado
  [ -d "$dir/__Installer" ] || [ -f "$dir/EAStore.ini" ] || [ -n "$(find "$dir" -maxdepth 2 \( -iname 'uplay_r1_loader*.dll' \
    -o -iname 'upc_r*_loader*.dll' -o -iname 'PlayGTAV.exe' -o -iname 'Link2EA*' \) 2>/dev/null | head -1)" ] && return 1
  exe=$(game_exe "$dir")
  [ -n "$exe" ] || return 1
  # O D3DMetal só roda jogos de 64 bits. Os de 32 bits (ex.: LEGO Marvel, LEGO O Hobbit) travavam na
  # tela de carregamento: vão direto para o Wine Staging e ficam marcados para não tentar de novo.
  if exe_is_32bit "$exe"; then set_d3dmetal "$id" off; return 1; fi
  case ":$(transparent_exes "$BOTTLE"):" in *":$(basename "$exe"):"*) return 1 ;; esac
  shadow=$(d3dmetal_prefix) || return 1
  no_steam_restart "$exe" "$id"
  key=$(unity_prefs_key "$exe")
  mkdir -p "$LOG_DIR"
  (
    [ -n "$key" ] && copy_reg_key "$WINE" "$WINEPREFIX" "$GPTK_WINE" "$shadow" "$key"
    start=$(date +%s)
    echo "$id" > "$shadow/.winmac-playing"; rm -f "$shadow/.winmac-killed"
    cd "$(dirname "$exe")" && WINEPREFIX="$shadow" WINEDEBUG="$GAME_WINEDEBUG" "$GPTK_WINE" "$(basename "$exe")" \
      > "$LOG_DIR/$id.log" 2>&1
    WINEPREFIX="$shadow" "$GPTK_WINESERVER" -w
    rm -f "$shadow/.winmac-playing"
    if [ -f "$shadow/.winmac-killed" ]; then
      rm -f "$shadow/.winmac-killed"   # fechado no "Fechar tudo" (travou): não reabre sozinho
    elif [ $(( $(date +%s) - start )) -lt 20 ]; then
      set_d3dmetal "$id" off      # não abriu: na próxima vez vai direto para o Wine Staging
      play_direct "$id"
    elif [ -n "$key" ]; then
      copy_reg_key "$GPTK_WINE" "$shadow" "$WINE" "$WINEPREFIX" "$key"
    fi
  ) >/dev/null 2>&1 &
  disown
  echo "Abrindo jogo $id com o D3DMetal da Apple..."
}

# ---------- Ubisoft Connect (motor do CrossOver) ----------
# O Ubisoft Connect é de 32 bits e não roda no Wine Staging do Mac com chip Apple: nas chamadas ao sistema,
# a troca do modo 32 para o 64 bits do Rosetta (no wow64cpu.dll) às vezes falha, o código de 64 bits roda em
# modo 32 ("page fault on read access to 00002EC5") e o navegador dele (CEF) cai em loop ("CEF render process
# crashed"); às vezes cai o próprio upc.exe. É da mesma família do bug 60494 (ver vk32_for_exe).
# O Wine 11 feito do código aberto do CrossOver 26.3 (projeto Highball), com as bibliotecas do Sikarugir, não
# tem o problema. Ele roda num bottle-sombra (~/winmac/Bottles/.dx12-<bottle>) que usa a mesma pasta do
# Ubisoft Connect, da Steam e do usuário (login, saves). O CEF desenha por software, com as mesmas opções do
# steamwebhelper: pela GPU a janela fica vazia.
CX_DIR="$HOME_DIR/engines/cx26.3-hb35"
CX_WINE="$CX_DIR/engine/bin/wine"
CX_WINESERVER="$CX_DIR/engine/bin/wineserver"
CX_ENGINE_URL="https://github.com/gauthierpiarrette/highball-engine/releases/download/engine-wine-11.0-20261114T185735Z-fiber-mirror-switch/engine-wine-11.0-20261114T185735Z-fiber-mirror-switch.tar.gz"
CX_ENGINE_SHA="ee1609f037b77d9a1896f3444c7d939ce91f39c81ffa729fdf4d6bdddb34af89"
CX_RUNTIME_URL="https://github.com/Sikarugir-App/Template/releases/download/v1.0/Template-1.0.11.tar.xz"
CX_RUNTIME_SHA="9fa15479e7ff6abd99c1d07be285fb95f41fc6991586502427152b1f7d6ccb8a"
UBI_SUBDIR="Program Files (x86)/Ubisoft/Ubisoft Game Launcher"
UBI_EXE='C:\Program Files (x86)\Ubisoft\Ubisoft Game Launcher\upc.exe'

cx_download() {  # <url> <sha256> <arquivo>
  curl -fL# --retry 3 -o "$3" "$1" && [ "$(shasum -a 256 "$3" | cut -d' ' -f1)" = "$2" ]
}
install_cx_engine() {
  [ -x "$CX_WINE" ] && [ -d "$CX_DIR/frameworks" ] && return 0
  echo "Baixando o motor do CrossOver (só na primeira vez, ~400 MB)..."
  local tmp ok=1; tmp=$(mktemp -d) || return 1
  if cx_download "$CX_ENGINE_URL" "$CX_ENGINE_SHA" "$tmp/engine.tar.gz" &&
     cx_download "$CX_RUNTIME_URL" "$CX_RUNTIME_SHA" "$tmp/runtime.tar.xz"; then
    echo "Instalando o motor do CrossOver..."
    mkdir -p "$tmp/x" "$CX_DIR" && tar -xzf "$tmp/engine.tar.gz" -C "$tmp/x" && tar -xJf "$tmp/runtime.tar.xz" -C "$tmp/x" &&
      rm -rf "$CX_DIR/engine" "$CX_DIR/frameworks" &&
      mv "$tmp/x/engine" "$CX_DIR/engine" && mv "$tmp/x"/Template-*.app/Contents/Frameworks "$CX_DIR/frameworks" && ok=0
    # O runtime traz o D3DMetal da Apple, que o WinMac não usa aqui (o Ubisoft Connect é de 32 bits, e o
    # D3DMetal só tem a parte de 64 bits) nem guarda (a licença da Apple não permite redistribuir)
    rm -rf "$CX_DIR/frameworks/renderer/apple_gptk" "$CX_DIR/frameworks/renderer/d3dmetal"
  fi
  rm -rf "$tmp"
  xattr -dr com.apple.quarantine "$CX_DIR" 2>/dev/null
  [ "$ok" = 0 ] && [ -x "$CX_WINE" ] || { echo "Falha ao baixar o motor do CrossOver. Confira a internet e tente de novo."; return 1; }
}

# Variáveis do motor do CrossOver. Use num subshell: não pode misturar com as do Wine Staging.
cx_env() {
  local fw="$CX_DIR/frameworks"
  unset DYLD_INSERT_LIBRARIES VK_ADD_IMPLICIT_LAYER_PATH WINEESYNC
  export DYLD_FALLBACK_FRAMEWORK_PATH="$fw" DYLD_FALLBACK_LIBRARY_PATH="$fw:$fw/GStreamer.framework/Versions/1.0/lib"
  export GST_PLUGIN_PATH="$fw/GStreamer.framework/Versions/1.0/lib/gstreamer-1.0"
  # D3DMetal: só existe se veio de outro lugar (ex.: testes de DirectX 12 neste motor)
  [ -d "$fw/renderer/d3dmetal/wine" ] && export WINEDLLPATH_PREPEND="$fw/renderer/d3dmetal/wine" \
    CX_APPLEGPTK_LIBD3DSHARED_PATH="$fw/renderer/apple_gptk/external/libd3dshared.dylib"
  export WINEPREFIX="$1" WINEDEBUG="$GAME_WINEDEBUG"
}

# Bottle-sombra do motor do CrossOver, com links para a pasta de usuário, a da Steam e a do Ubisoft do bottle
cx_prefix() {
  local shadow="$HOME_DIR/Bottles/.dx12-$(basename "$WINEPREFIX")" u="$USER" d
  if [ ! -d "$shadow/drive_c/windows" ]; then
    echo "Preparando o motor do CrossOver (só na primeira vez)..." >&2
    ( cx_env "$shadow"; "$CX_WINE" wineboot -i >/dev/null 2>&1; "$CX_WINESERVER" -w )
    [ -d "$shadow/drive_c/windows" ] || return 1
  fi
  if [ -n "$u" ] && [ -d "$WINEPREFIX/drive_c/users/$u" ] && [ ! -L "$shadow/drive_c/users/$u" ]; then
    rm -rf "$shadow/drive_c/users/$u" && ln -s "$WINEPREFIX/drive_c/users/$u" "$shadow/drive_c/users/$u"
  fi
  for d in "Program Files (x86)/Steam" "Program Files (x86)/Ubisoft"; do
    [ -d "$WINEPREFIX/drive_c/$d" ] && [ ! -e "$shadow/drive_c/$d" ] && ln -s "$WINEPREFIX/drive_c/$d" "$shadow/drive_c/$d"
  done
  echo "$shadow"
}

# O wineserver do bottle está aberto? (o lock do servidor fica preso enquanto ele roda)
wineserver_up() {
  local lock="/tmp/.wine-$(id -u)/server-$(printf '%x-%x' $(stat -f '%d %i' "$1"))/lock"
  [ -f "$lock" ] && lsof -t "$lock" >/dev/null 2>&1
}

# Processo dono da janela "Ubisoft Connect" (vazio se ela ainda não existe)
ubisoft_window_pid() {
  osascript -l JavaScript -e '
    ObjC.import("CoreGraphics"); ObjC.import("Foundation");
    var l = ObjC.castRefToObject($.CGWindowListCopyWindowInfo($.kCGWindowListOptionAll, 0)), pid = "";
    for (var i = 0; i < l.count && !pid; i++) {
      var w = l.objectAtIndex(i);
      if (ObjC.unwrap(w.objectForKey("kCGWindowName")) === "Ubisoft Connect") pid = String(ObjC.unwrap(w.objectForKey("kCGWindowOwnerPID")));
    }
    pid' 2>/dev/null
}

open_ubisoft() {
  local shadow exe
  [ -f "$WINEPREFIX/drive_c/$UBI_SUBDIR/upc.exe" ] || { echo "O Ubisoft Connect não está instalado neste bottle."; return 1; }
  install_cx_engine || return 1
  # Uma cópia aberta no Wine Staging (ex.: por um jogo) fica caindo em loop e usa a mesma pasta: fecha só ela
  if wineserver_up "$WINEPREFIX"; then
    for exe in upc.exe UplayWebCore.exe UplayService.exe UbisoftConnect.exe UplayCrashReporter.exe; do
      "$WINE" taskkill /f /im "$exe" >/dev/null 2>&1
    done
  fi
  shadow=$(cx_prefix) || { echo "Não consegui preparar o motor do CrossOver."; return 1; }
  mkdir -p "$LOG_DIR"
  (
    cx_env "$shadow"
    cd "$shadow/drive_c/$UBI_SUBDIR" || exit 1
    # Já aberto: o upc.exe é de instância única e só mostra a janela que já existe
    "$CX_WINE" "$UBI_EXE" -upc_desktop_mode $WEBHELPER_FLAGS >> "$LOG_DIR/ubisoft-connect.log" 2>&1 &
    # O app "wine" do motor deixa a janela fora da tela até ser ativado: traz para a frente quando ela aparece
    for _ in $(seq 1 90); do
      pid=$(ubisoft_window_pid)
      if [ -n "$pid" ]; then
        sleep 2
        osascript -e "tell application \"System Events\" to set frontmost of (first process whose unix id is $pid) to true"
        break
      fi
      sleep 1
    done
  ) >/dev/null 2>&1 &
  disown
  echo "Abrindo o Ubisoft Connect..."
}
kill_cx() {
  local shadow="$HOME_DIR/Bottles/.dx12-$(basename "$WINEPREFIX")"
  [ -x "$CX_WINESERVER" ] && [ -d "$shadow" ] || return 0
  ( cx_env "$shadow"; "$CX_WINESERVER" -k 2>/dev/null )
}

# ---------- Atualização automática (o app chama "winmac update <caminho do app>" ao abrir) ----------
# Tudo vem da última versão publicada (tag), e não do main: assim nunca chega um arquivo pela metade
# ou de cache antigo, e o app, o comando e as ferramentas sempre ficam da mesma versão.
REPO="Yohotaco/winmac"
self_update() {
  local app="$1" tmp f latest cur
  latest=$(latest_tag)
  [ -n "$latest" ] || { echo "UPDATE_ERRO Não consegui falar com o GitHub. Confira a internet e tente de novo."; return 1; }
  tmp=$(mktemp -d) || { echo "UPDATE_ERRO Não consegui criar uma pasta temporária. Confira o espaço livre no disco."; return 1; }
  # Comando e ferramentas: troca só o que mudou (mv cria arquivo novo, então não atrapalha quem está usando)
  for f in winmac tools/steamwebhelper-wrap.exe tools/winmac-transparent.dylib tools/winmac-dxmt.dylib tools/winmac-progman.exe tools/lossless-wrap.exe tools/winmac-vk32.dylib tools/winmac-vk32.json; do
    if ! curl -fsL --max-time 60 -o "$tmp/new" "https://raw.githubusercontent.com/$REPO/$latest/$f" || [ ! -s "$tmp/new" ]; then
      [ "$f" = winmac ] || continue
      echo "UPDATE_ERRO Não consegui baixar a nova versão. Confira a internet e tente de novo."
      rm -rf "$tmp"
      return 1
    fi
    cmp -s "$tmp/new" "$HOME_DIR/$f" && continue
    mkdir -p "$(dirname "$HOME_DIR/$f")" && chmod +x "$tmp/new" && mv "$tmp/new" "$HOME_DIR/$f" && echo "Atualizado: $f"
  done
  # App: compara a versão instalada com a publicada
  if [ -n "$app" ] && [ -d "$app/Contents" ]; then
    cur=$(/usr/libexec/PlistBuddy -c "Print :CFBundleShortVersionString" "$app/Contents/Info.plist" 2>/dev/null || echo 0)
    if [ "${latest#v}" != "$cur" ] && [ "$(printf '%s\n%s\n' "$cur" "${latest#v}" | sort -V | tail -1)" = "${latest#v}" ]; then
      if ! curl -fsL --max-time 300 -o "$tmp/app.zip" "https://github.com/$REPO/releases/download/$latest/WinMac.zip" ||
         ! ditto -x -k "$tmp/app.zip" "$tmp/app" || [ ! -x "$tmp/app/WinMac.app/Contents/MacOS/WinMac" ]; then
        echo "UPDATE_ERRO Não consegui baixar a nova versão. Confira a internet e tente de novo."
      # Tira o app velho de lado antes de pôr o novo: se algo falhar, ele volta para o lugar
      elif ! mv "$app" "$tmp/old" 2>/dev/null; then
        echo "UPDATE_ERRO Sem permissão para trocar o WinMac em $app. Apague esse app e baixe a versão nova pelo site."
      elif mv "$tmp/app/WinMac.app" "$app"; then
        echo "APP_ATUALIZADO ${latest#v}"
      else
        mv "$tmp/old" "$app"
        echo "UPDATE_ERRO Não consegui colocar a versão nova em $app. Baixe a versão nova pelo site."
      fi
    fi
  fi
  rm -rf "$tmp"
}

# ---------- Quadros extras (no lugar do Lossless Scaling) ----------
# O Lossless Scaling fecha ao abrir no Wine: ele captura a tela com funções que só o Windows tem (o DXMT
# responde "Not implemented" e o programa cai em UI.Core.Init). O WinMac Quadros (tools/framegen.swift, um app
# dentro do WinMac.app) faz o mesmo trabalho pelo macOS: captura a janela do jogo, cria os quadros
# intermediários com o interpolador do VideoToolbox (macOS 26+, no Neural Engine) e mostra tudo numa janela por
# cima do jogo que deixa o mouse passar. A janela dele mostra se está ligado e o FPS; Control+Option+S (o atalho
# do Lossless Scaling) liga e desliga no jogo da frente.
FG_CONF="$HOME_DIR/framegen.conf"
LOSSLESS_APPID=993090
QUADROS_PROC='WinMac Quadros.app/Contents/MacOS/WinMac Quadros'
quadros_app() {
  local d
  for d in /Applications "$HOME/Applications"; do
    [ -x "$d/WinMac.app/Contents/Helpers/$QUADROS_PROC" ] && { echo "$d/WinMac.app/Contents/Helpers/WinMac Quadros.app"; return 0; }
  done
  return 1
}

# A Steam abre o Lossless Scaling pelo embrulho (tools/lossless_wrap.c), que abre o WinMac Quadros no lugar
# do original. O original fica como LosslessScaling_real.exe. O embrulho fica com o mesmo tamanho do original
# (completado com zeros), porque a Steam confere o tamanho dos arquivos.
LOSSLESS_WRAP="$HOME_DIR/tools/lossless-wrap.exe"
fix_lossless() {
  local dir="$WINEPREFIX/drive_c/Program Files (x86)/Steam/steamapps/common/Lossless Scaling"
  local exe="$dir/LosslessScaling.exe" real="$dir/LosslessScaling_real.exe" wsize rsize
  [ -f "$exe" ] && [ -f "$LOSSLESS_WRAP" ] || return 0
  wsize=$(stat -f%z "$LOSSLESS_WRAP")
  cmp -s "$LOSSLESS_WRAP" <(head -c "$wsize" "$exe") && return 0
  # Sem a marca do embrulho: é o original (ou uma versão nova que a Steam baixou)
  grep -q -a WINMAC_LOSSLESS_WRAP "$exe" || mv -f "$exe" "$real"
  [ -f "$real" ] || return 0
  rsize=$(stat -f%z "$real")
  cp "$LOSSLESS_WRAP" "$exe.tmp" || return 0
  [ "$rsize" -gt "$wsize" ] && dd if=/dev/zero of="$exe.tmp" bs=1 count=0 seek="$rsize" 2>/dev/null
  mv -f "$exe.tmp" "$exe"
}

framegen() {
  # Versão de testes anterior: ferramenta solta na barra de menus
  pkill -f "$HOME_DIR/tools/winmac-fg" 2>/dev/null; rm -f "$HOME_DIR/tools/winmac-fg"
  case "$1" in
    off)
      if pkill -f "$QUADROS_PROC"; then echo "Quadros extras fechados."; else echo "Os quadros extras já estavam fechados."; fi
      return 0 ;;
    2x|3x|4x)
      { grep -v '^multiplier=' "$FG_CONF" 2>/dev/null; echo "multiplier=${1%x}"; } > "$FG_CONF.tmp" && mv "$FG_CONF.tmp" "$FG_CONF"
      pkill -HUP -f "$QUADROS_PROC" ;;
    ""|on) ;;
    *) echo "Uso: winmac fg [off|2x|3x|4x]"; return 1 ;;
  esac
  if [ "$(sw_vers -productVersion | cut -d. -f1)" -lt 26 ]; then
    echo "Os quadros extras precisam do macOS 26 ou mais novo."; return 1
  fi
  local app
  app=$(quadros_app) || { echo "Não encontrei o WinMac Quadros dentro do WinMac.app. Atualize o WinMac."; return 1; }
  [ -f "$LOSSLESS_WRAP" ] || ensure_tools
  WINEPREFIX="$(bottle_path)" fix_lossless
  open "$app" || { echo "Não consegui abrir o WinMac Quadros."; return 1; }
  echo "Quadros extras abertos: clique em Ligar no jogo (ou aperte Control+Option+S dentro do jogo)."
}

# Bottles do CrossOver com Steam instalada que ainda não foram trazidos para o WinMac
cx_steam_bottles() {
  local b
  for b in "$CX_BOTTLES"/*; do
    [ -d "$b" ] && [ ! -L "$b" ] && [ -f "$b/drive_c/Program Files (x86)/Steam/steam.exe" ] && basename "$b"
  done
}

count_games() { ls "$1/drive_c/Program Files (x86)/Steam/steamapps/"appmanifest_*.acf 2>/dev/null | grep -vc appmanifest_228980; }

# Move cada bottle do CrossOver com Steam para ~/winmac/Bottles, deixando um atalho no lugar antigo
# (o CrossOver continua achando ele). Jogos, saves e o login da Steam vêm junto.
import_crossover() {
  local names name dest n=0
  names=$(cx_steam_bottles)
  [ -n "$names" ] || { echo "Nenhuma Steam do CrossOver encontrada."; return 1; }
  if pgrep -f "CrossOver.app/" >/dev/null; then
    echo "Fechando o CrossOver..."
    osascript -e 'quit app "CrossOver"' >/dev/null 2>&1
    for name in $names; do
      WINEPREFIX="$CX_BOTTLES/$name" /Applications/CrossOver.app/Contents/SharedSupport/CrossOver/bin/wineserver -k 2>/dev/null
    done
    for i in $(seq 1 15); do pgrep -f "CrossOver.app/" >/dev/null || break; sleep 1; done
    pgrep -f "CrossOver.app/.*wineserver" >/dev/null && { echo "Não consegui fechar o CrossOver. Feche ele e tente de novo."; return 1; }
  fi
  mkdir -p "$HOME_DIR/Bottles"
  while IFS= read -r name; do
    dest="$name"; [ -e "$HOME_DIR/Bottles/$dest" ] && dest="$name (CrossOver)"
    echo "Trazendo '$name' do CrossOver..."
    mv "$CX_BOTTLES/$name" "$HOME_DIR/Bottles/$dest" && ln -s "$HOME_DIR/Bottles/$dest" "$CX_BOTTLES/$name" || continue
    ( setup_env "$dest" )   # guarda as DLLs do CrossOver e instala o DXVK
    echo "Pronto: '$dest' com $(count_games "$HOME_DIR/Bottles/$dest") jogo(s)."
    n=$((n + 1))
  done <<< "$names"
  [ $n -gt 0 ]
}

steam_apps() { echo "$(bottle_path "$1")/drive_c/Program Files (x86)/Steam/steamapps"; }

# O instalador da Valve só traz o básico: o resto vem na primeira abertura. Com -noverifyfiles a Steam pode
# pular esse download e fechar com "Failed to load steamui.dll", então a primeira abertura é sem a opção.
# Pronta = steamui.dll inteiro (arquivo cortado ou ausente dá "Failed to load steamui.dll")
steam_files_ok() {
  [ "$(stat -f%z "$1/steamui.dll" 2>/dev/null || echo 0)" -gt 1000000 ]
}
steam_ready() { steam_files_ok "$(bottle_path "$1")/drive_c/Program Files (x86)/Steam"; }
first_boot() {
  local dir="$WINEPREFIX/drive_c/Program Files (x86)/Steam" try i now last idle limit m saved=("${STEAM_ARGS[@]}")
  # Instalação incompleta (ex.: download cortado): tira o marcador de "instalado" para a Steam conferir tudo e baixar o que falta
  for m in "$dir/package/steam_client_win32.installed" "$dir/package/steam_client_win64.installed"; do
    [ -f "$m" ] && mv -f "$m" "$m.incompleto"
  done
  for try in 1 2 3 4 5; do
    # Da segunda tentativa em diante, sem -noverifyfiles: a Steam confere os arquivos e baixa os que faltam
    [ "$try" -ge 2 ] && STEAM_ARGS=()
    echo "Baixando os arquivos da Steam (tentativa $try de 5, só na primeira vez)..."
    launch_steam
    last=-1; idle=0
    # Pronta quando já chegou a abrir o navegador interno, ou seja, terminou de extrair tudo.
    # Às vezes o download dentro do Wine para sem dar erro: sem começar em 1 minuto (ou parado
    # por 5 depois de começar, para não atrapalhar internet lenta), tenta de novo.
    for i in $(seq 1 400); do
      steam_files_ok "$dir" && [ -f "$dir/logs/webhelper.txt" ] && break
      sleep 3
      now=$(du -sk "$dir/package" "$dir/steamui.dll" 2>/dev/null | awk '{s+=$1} END {print s+0}')
      if [ "$now" != "$last" ]; then
        [ "$last" != -1 ] && echo "Baixando a Steam: $((now / 1024)) MB..."
        last=$now; idle=0
      else
        idle=$((idle + 3))
        limit=60; [ -n "$(ls -A "$dir/package" 2>/dev/null)" ] && limit=300
        [ "$idle" -ge "$limit" ] && break
      fi
    done
    "$WINESERVER" -k; "$WINESERVER" -w
    if steam_files_ok "$dir"; then
      # Devolve o marcador se a Steam não recriou (arquivos conferidos, nada a baixar)
      for m in "$dir"/package/*.installed.incompleto; do
        [ -f "$m" ] || continue
        [ -f "${m%.incompleto}" ] && rm -f "$m" || mv -f "$m" "${m%.incompleto}"
      done
      STEAM_ARGS=("${saved[@]}"); return 0
    fi
  done
  echo "A Steam não conseguiu baixar os arquivos. Se usa VPN (WARP, Windscribe), desligue e clique em Abrir Steam de novo."
  exit 1
}

# Instala o Wine e a Steam oficial num bottle (ou traz a Steam do CrossOver, se houver)
do_setup() {
  local name="${1:-$DEFAULT_BOTTLE}"
  install_wine
  # Se já existe uma Steam no CrossOver, usa ela (com jogos, saves e login) em vez de instalar outra
  if [ -n "$(cx_steam_bottles)" ] && ! steam_installed "$name"; then
    import_crossover && { echo "Steam do CrossOver importada! Clique em Abrir Steam."; return 0; }
  fi
  if steam_installed "$name"; then echo "A Steam já está instalada no bottle '$name'."; return 0; fi
  mkdir -p "$HOME_DIR/Bottles/$name"
  setup_env "$name"
  echo "Criando o bottle '$name'..."
  "$WINE" wineboot --init >/dev/null 2>&1
  "$WINESERVER" -w
  echo "Baixando a Steam oficial da Valve..."
  curl -fL# -o "$WINEPREFIX/drive_c/SteamSetup.exe" "$STEAM_SETUP_URL" || { echo "Falha ao baixar a Steam."; exit 1; }
  echo "Instalando a Steam..."
  "$WINE" 'C:\SteamSetup.exe' /S >/dev/null 2>&1
  "$WINESERVER" -w
  rm -f "$WINEPREFIX/drive_c/SteamSetup.exe"
  configure_bottle
  steam_installed "$name" || { echo "A instalação da Steam falhou."; exit 1; }
  first_boot
  echo "Steam instalada! Clique em Abrir Steam."
}

case "$1" in
  detect)
    cx_steam_bottles | while IFS= read -r b; do printf "%s\t%s\n" "$b" "$(count_games "$CX_BOTTLES/$b")"; done ;;
  import)
    install_wine
    import_crossover && echo "Steam do CrossOver importada! Clique em Abrir Steam." ;;
  setup)
    do_setup "$2" ;;
  list)
    for b in "$HOME_DIR/Bottles"/* "$CX_BOTTLES"/*; do
      [ -d "$b" ] && [ ! -L "$b" ] || continue
      echo "== Bottle: $(basename "$b")"
      for f in "$b/drive_c/Program Files (x86)/Steam/steamapps/"appmanifest_*.acf; do
        [ -f "$f" ] || continue
        id=$(sed -n 's/.*"appid"[[:space:]]*"\([0-9]*\)".*/\1/p' "$f")
        nm=$(sed -n 's/.*"name"[[:space:]]*"\(.*\)".*/\1/p' "$f")
        printf "   %-10s %s\n" "$id" "$nm"
      done
    done ;;
  steam)
    steam_installed "$2" || do_setup "$2"
    setup_env "$2"
    steam_ready "$2" || first_boot
    fix_webhelper
    BOTTLE="$2"; launch_steam; echo "Steam abrindo..." ;;
  play)
    if [ "$2" = "$LOSSLESS_APPID" ] || [[ "$2" =~ ^[Ll]ossless ]]; then
      echo "O Lossless Scaling não roda no Wine; o WinMac faz o mesmo com os quadros extras."
      framegen; exit $?
    fi
    setup_env "$3"
    id="$2"
    if ! [[ "$id" =~ ^[0-9]+$ ]]; then
      f=$(grep -il "\"name\".*$id" "$(steam_apps "$3")"/appmanifest_*.acf | head -1)
      id=$(sed -n 's/.*"appid"[[:space:]]*"\([0-9]*\)".*/\1/p' "$f")
    fi
    [ -n "$id" ] || { echo "Jogo não encontrado. Use: winmac list"; exit 1; }
    BOTTLE="$3"
    # Sem a Steam: o .exe do jogo abre direto (D3DMetal se der, senão Wine Staging, como o "winmac run")
    play_d3dmetal "$id" && exit 0
    play_direct "$id" || { echo "Não achei o .exe do jogo $id. Ele terminou de baixar?"; exit 1; } ;;
  d3dmetal)
    [[ "$2" =~ ^[0-9]+$ ]] && [[ "$3" =~ ^(on|off)$ ]] || { echo "Uso: winmac d3dmetal <appid> on|off"; exit 1; }
    set_d3dmetal "$2" "$3"; echo "D3DMetal $3 para o jogo $2." ;;
  add)
    add_program "$2" "$3" ;;
  run)
    setup_env "$3"
    BOTTLE="${3:-$DEFAULT_BOTTLE}"
    run_program "$2"
    echo "Abrindo $(basename "$2")..." ;;
  kill)
    export WINEPREFIX="$(bottle_path "$2")"; "$WINESERVER" -k; kill_d3dmetal; kill_cx; echo "Bottle fechado." ;;
  ubisoft)
    setup_env "$2"
    open_ubisoft ;;
  logs)
    mkdir -p "$LOG_DIR"; open "$LOG_DIR"; echo "Logs em $LOG_DIR" ;;
  fg)
    framegen "$2" ;;
  migrate)
    name="${2:-$DEFAULT_BOTTLE}"; src="$CX_BOTTLES/$name"
    [ -d "$src" ] && [ ! -L "$src" ] || { echo "Nada para migrar em $src"; exit 1; }
    pgrep -f "CrossOver.app/.*wineserver" >/dev/null && { echo "Feche o CrossOver primeiro."; exit 1; }
    mkdir -p "$HOME_DIR/Bottles" && mv "$src" "$HOME_DIR/Bottles/$name" && ln -s "$HOME_DIR/Bottles/$name" "$src"
    echo "Bottle '$name' agora mora em ~/winmac/Bottles (o CrossOver ainda acha ele pelo atalho)." ;;
  wallpaper)
    BOTTLE="${3:-$DEFAULT_BOTTLE}"
    case "$2" in
      off)
        launchctl bootout "gui/$(id -u)/com.winmac.wallpaper" 2>/dev/null
        rm -f "$WP_AGENT"; touch "$WP_OFF"
        export WINEPREFIX="$(bottle_path "$BOTTLE")"; "$WINE" taskkill /IM wallpaper64.exe >/dev/null 2>&1
        echo "Papel de parede animado desligado." ;;
      run)   # chamado pelo item de login: fica rodando enquanto o motor estiver aberto
        setup_env "$3"
        exe="$(wallpaper_exe "$BOTTLE")"
        [ -f "$exe" ] || { echo "Wallpaper Engine não instalado no bottle $BOTTLE"; sleep 3600; exit 1; }
        if pgrep -f "$WP_PROC" >/dev/null; then   # já aberto (pela Steam): só acompanha
          while pgrep -f "$WP_PROC" >/dev/null; do sleep 10; done; exit 0
        fi
        prepare_launch
        sleep 5   # o motor precisa achar a área de trabalho (winmac-progman) já criada
        cd "$(dirname "$exe")" && "$WINE" 'C:\Program Files (x86)\Steam\steamapps\common\wallpaper_engine\wallpaper64.exe' -nobrowse >/dev/null 2>&1 ;;
      *)
        [ -f "$(wallpaper_exe "$BOTTLE")" ] || { echo "Wallpaper Engine não instalado no bottle $BOTTLE"; exit 1; }
        rm -f "$WP_OFF"; wallpaper_agent_on "$BOTTLE"
        echo "Papel de parede animado ligado: abre sozinho ao entrar no Mac, mesmo sem a Steam." ;;
    esac ;;
  update)
    self_update "$2" ;;
  restore)
    p="$(bottle_path "$2")"; cp "$HOME_DIR/backup/"{system,user,userdef}.reg "$p/" && echo "Registro restaurado." ;;
  *)
    sed -n '2,/^$/p' "$0" | grep '^#' | sed 's/^# \{0,1\}//' ;;
esac
