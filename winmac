#!/bin/bash
# winmac — roda seus jogos Windows no Mac com o Wine Staging (grátis, open source).
# Uso:
#   winmac setup [bottle]     instala o Wine (se faltar) e a Steam oficial num bottle novo
#   winmac list               lista bottles e jogos da Steam
#   winmac steam [bottle]     abre a Steam
#   winmac play <appid|nome>  abre um jogo pela Steam
#   winmac run <exe> [bottle] roda qualquer .exe
#   winmac migrate [bottle]   move o bottle do CrossOver para ~/winmac/Bottles (deixa atalho de volta)
#   winmac kill [bottle]      fecha tudo que está rodando no bottle
#   winmac restore [bottle]   restaura o registro original do CrossOver (backup)

WINE="/Applications/Wine Staging.app/Contents/Resources/wine/bin/wine"
WINESERVER="/Applications/Wine Staging.app/Contents/Resources/wine/bin/wineserver"
HOME_DIR="$HOME/winmac"
CX_BOTTLES="$HOME/Library/Application Support/CrossOver/Bottles"
DEFAULT_BOTTLE="Steam"
STEAM_EXE='C:\Program Files (x86)\Steam\steam.exe'
# -noverifyfiles: impede a Steam de desfazer o embrulho do steamwebhelper (ver fix_webhelper)
STEAM_ARGS=(-noverifyfiles)
WRAP_EXE="$HOME_DIR/tools/steamwebhelper-wrap.exe"
WEBHELPER_FLAGS="--disable-gpu --disable-gpu-compositing --in-process-gpu --disable-features=CalculateNativeWinOcclusion --disable-direct-composition"

bottle_path() {
  local name="${1:-$DEFAULT_BOTTLE}"
  if [ -d "$HOME_DIR/Bottles/$name" ]; then echo "$HOME_DIR/Bottles/$name"
  else echo "$CX_BOTTLES/$name"; fi
}

# DLLs que o CrossOver coloca no bottle e que derrubam o Wine comum (ex.: steamwebhelper.exe trava).
# Ficam guardadas em ~/winmac/crossover-dlls/<bottle> para poder devolver.
CX_DLLS=(system32/atidxx64.dll system32/nvapi64.dll system32/nvngx.dll system32/nvngx-on-metalfx.dll
         system32/winemetal.dll system32/wpcap.dll syswow64/winemetal.dll syswow64/wpcap.dll)
set_aside_crossover_dlls() {
  local win="$1/drive_c/windows" dest="$HOME_DIR/crossover-dlls/$(basename "$1")" f
  for f in "${CX_DLLS[@]}"; do
    [ -f "$win/$f" ] || continue
    mkdir -p "$dest/$(dirname "$f")" && mv "$win/$f" "$dest/$f"
  done
}

setup_env() {
  export WINEPREFIX="$(bottle_path "$1")"
  export WINEESYNC=1
  export WINEDEBUG=-all
  export MTL_HUD_ENABLED="${MTL_HUD_ENABLED:-0}"
  # Bottles do CrossOver usam o usuário Windows "crossover"; mantém o mesmo para os saves continuarem no lugar
  [ -d "$WINEPREFIX/drive_c/users/crossover" ] && export USER=crossover
  [ -x "$WINE" ] || { echo "Wine Staging não encontrado em /Applications/Wine Staging.app"; exit 1; }
  [ -d "$WINEPREFIX" ] || { echo "Bottle não encontrado: $WINEPREFIX"; exit 1; }
  set_aside_crossover_dlls "$WINEPREFIX"
  if pgrep -f "CrossOver.app/.*wineserver" >/dev/null; then
    echo "O CrossOver está rodando. Feche a Steam/CrossOver antes de usar o winmac no mesmo bottle."; exit 1
  fi
  configure_bottle
}

WINE_URL="https://github.com/Gcenx/macOS_Wine_builds/releases/download/11.18/wine-staging-11.18-osx64.tar.xz"
DXVK_URL="https://github.com/Gcenx/DXVK-macOS/releases/download/v1.10.3-20230507-repack/dxvk-macOS-async-v1.10.3-20230507-repack.tar.gz"
STEAM_SETUP_URL="https://cdn.cloudflare.steamstatic.com/client/installer/SteamSetup.exe"

install_wine() {
  [ -x "$WINE" ] && return 0
  echo "Baixando o Wine Staging..."
  local tmp; tmp=$(mktemp -d)
  curl -fL# -o "$tmp/wine.tar.xz" "$WINE_URL" && tar -xJf "$tmp/wine.tar.xz" -C "$tmp" \
    && mv "$tmp/Wine Staging.app" /Applications/ && xattr -dr com.apple.quarantine "/Applications/Wine Staging.app"
  rm -rf "$tmp"
  [ -x "$WINE" ] || { echo "Falha ao instalar o Wine."; exit 1; }
}

# DXVK (DirectX 10/11 -> Vulkan/Metal): sem ele os jogos DX11 falham com "Failed to initialize graphics"
install_dxvk() {
  local cache="$HOME_DIR/dxvk" src d
  src=$(ls -d "$cache"/dxvk-macOS-* 2>/dev/null | head -1)
  if [ -z "$src" ]; then
    echo "Baixando o DXVK..."
    mkdir -p "$cache" && curl -fsL "$DXVK_URL" | tar -xz -C "$cache" || { echo "Falha ao baixar o DXVK."; return 1; }
    src=$(ls -d "$cache"/dxvk-macOS-* | head -1)
  fi
  for d in d3d11 d3d10core; do
    cp "$src/x64/$d.dll" "$WINEPREFIX/drive_c/windows/system32/"
    cp "$src/x32/$d.dll" "$WINEPREFIX/drive_c/windows/syswow64/"
    "$WINE" reg add 'HKCU\Software\Wine\DllOverrides' /v $d /t REG_SZ /d native,builtin /f >/dev/null 2>&1
  done
}

# Ajustes feitos uma vez por bottle
configure_bottle() {
  [ -f "$WINEPREFIX/.winmac-ok" ] && return 0
  [ -d "$WINEPREFIX/drive_c/windows/system32" ] || return 0   # bottle ainda vazio (winmac setup)
  install_dxvk || return 1
  "$WINE" reg add 'HKCU\Software\Wine\WineDbg' /v ShowCrashDialog /t REG_DWORD /d 0 /f >/dev/null 2>&1
  touch "$WINEPREFIX/.winmac-ok"
}

steam_installed() { [ -f "$(bottle_path "$1")/drive_c/Program Files (x86)/Steam/steam.exe" ]; }

# A janela da Steam fica preta no Wine do macOS porque o navegador interno (steamwebhelper)
# desenha pela GPU. O embrulho chama o steamwebhelper original com opções do Chromium para
# desenhar por software. Se a Steam se atualizar e trocar o arquivo, ele é reaplicado aqui.
fix_webhelper() {
  local dir="$WINEPREFIX/drive_c/Program Files (x86)/Steam/bin/cef/cef.win64"
  [ -f "$dir/steamwebhelper.exe" ] && [ -f "$WRAP_EXE" ] || return 0
  if ! cmp -s "$WRAP_EXE" "$dir/steamwebhelper.exe"; then
    mv -f "$dir/steamwebhelper.exe" "$dir/steamwebhelper_real.exe"
    cp "$WRAP_EXE" "$dir/steamwebhelper.exe"
  fi
  echo "$WEBHELPER_FLAGS" > "$dir/winmac_flags.txt"
}

steam_apps() { echo "$(bottle_path "$1")/drive_c/Program Files (x86)/Steam/steamapps"; }

case "$1" in
  setup)
    name="${2:-$DEFAULT_BOTTLE}"
    install_wine
    if steam_installed "$name"; then echo "A Steam já está instalada no bottle '$name'."; exit 0; fi
    mkdir -p "$HOME_DIR/Bottles/$name"
    setup_env "$name"
    echo "Criando o bottle '$name'..."
    "$WINE" wineboot --init >/dev/null 2>&1
    "$WINESERVER" -w
    echo "Baixando a Steam oficial da Valve..."
    curl -fL# -o "$WINEPREFIX/drive_c/SteamSetup.exe" "$STEAM_SETUP_URL" || { echo "Falha ao baixar a Steam."; exit 1; }
    echo "Instalando a Steam..."
    "$WINE" 'C:\SteamSetup.exe' /S >/dev/null 2>&1
    "$WINESERVER" -w
    rm -f "$WINEPREFIX/drive_c/SteamSetup.exe"
    configure_bottle
    steam_installed "$name" && echo "Steam instalada! Clique em Abrir Steam." || { echo "A instalação da Steam falhou."; exit 1; } ;;
  list)
    for b in "$HOME_DIR/Bottles"/* "$CX_BOTTLES"/*; do
      [ -d "$b" ] && [ ! -L "$b" ] || continue
      echo "== Bottle: $(basename "$b")"
      for f in "$b/drive_c/Program Files (x86)/Steam/steamapps/"appmanifest_*.acf; do
        [ -f "$f" ] || continue
        id=$(sed -n 's/.*"appid"[[:space:]]*"\([0-9]*\)".*/\1/p' "$f")
        nm=$(sed -n 's/.*"name"[[:space:]]*"\(.*\)".*/\1/p' "$f")
        printf "   %-10s %s\n" "$id" "$nm"
      done
    done ;;
  steam)
    setup_env "$2"
    fix_webhelper
    nohup "$WINE" "$STEAM_EXE" "${STEAM_ARGS[@]}" >/dev/null 2>&1 & echo "Steam abrindo..." ;;
  play)
    setup_env "$3"
    id="$2"
    if ! [[ "$id" =~ ^[0-9]+$ ]]; then
      f=$(grep -il "\"name\".*$id" "$(steam_apps "$3")"/appmanifest_*.acf | head -1)
      id=$(sed -n 's/.*"appid"[[:space:]]*"\([0-9]*\)".*/\1/p' "$f")
    fi
    [ -n "$id" ] || { echo "Jogo não encontrado. Use: winmac list"; exit 1; }
    fix_webhelper
    nohup "$WINE" "$STEAM_EXE" "${STEAM_ARGS[@]}" -applaunch "$id" >/dev/null 2>&1 & echo "Abrindo jogo $id..." ;;
  run)
    setup_env "$3"
    nohup "$WINE" "$2" >/dev/null 2>&1 & ;;
  kill)
    export WINEPREFIX="$(bottle_path "$2")"; "$WINESERVER" -k; echo "Bottle fechado." ;;
  migrate)
    name="${2:-$DEFAULT_BOTTLE}"; src="$CX_BOTTLES/$name"
    [ -d "$src" ] && [ ! -L "$src" ] || { echo "Nada para migrar em $src"; exit 1; }
    pgrep -f "CrossOver.app/.*wineserver" >/dev/null && { echo "Feche o CrossOver primeiro."; exit 1; }
    mkdir -p "$HOME_DIR/Bottles" && mv "$src" "$HOME_DIR/Bottles/$name" && ln -s "$HOME_DIR/Bottles/$name" "$src"
    echo "Bottle '$name' agora mora em ~/winmac/Bottles (o CrossOver ainda acha ele pelo atalho)." ;;
  restore)
    p="$(bottle_path "$2")"; cp "$HOME_DIR/backup/"{system,user,userdef}.reg "$p/" && echo "Registro restaurado." ;;
  *)
    sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
